PREFIX owl:   <http://www.w3.org/2002/07/owl#> 
PREFIX sosa:  <http://www.w3.org/ns/sosa/> 
PREFIX glosis_proc: <http://w3id.org/glosis/model/procedure/>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#> 
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ex: <http://example.org/ontology#>

CONSTRUCT {
### concept scheme
  glosis_proc: a skos:ConceptScheme ;
    skos:prefLabel ?cs_label ;
    rdfs:label ?cs_label ;
    skos:note ?cs_note ;
    .

### skos collection
  ?URI3 a skos:Collection ;
    skos:prefLabel ?c_label ;
    skos:note ?c_comment ;
    skos:definition ?cs_definition ;
    rdfs:seeAlso ?URI2 ;
    skos:member ?c_oneof ;
   .


### procedure class
  ?URI2 a owl:Class ;
    rdfs:subClassOf skos:Concept, sosa:Procedure ;
    rdfs:label ?c_label ;
    rdfs:comment ?c_comment ;
    skos:definition ?cs_definition ;
    rdfs:seeAlso ?URI3 ;
    # the query omitts a collection connected to owl:oneOf on purpose, this will be
    # properly added in postprocessing phase due to the limitations of TARQL! 
   .

### concepts
  ?c_oneof a skos:Concept; a ?URI2 ;
    skos:prefLabel ?i_label ;
    skos:notation  ?i_notation ;
    skos:definition ?i_description ;
    skos:scopeNote ?i_reference ;
    skos:scopeNote ?i_citation ;
    skos:inScheme ?URI1 ;
    skos:broader ?broaderURI ;
    .

  ?broaderURI skos:narrower ?c_oneof .
} 
WHERE {
  BIND (URI('http://w3id.org/glosis/model/procedure/') AS ?URI1)
  BIND (STRLANG(CONCAT('Code list for ', ' analysis procedures - codelist scheme'),"en") AS ?cs_label)
  BIND (STRLANG(CONCAT('This code list provides analysis procedures.'), "en") AS ?cs_note)
  BIND (STR('AfSP-derived interpretation (RwaSP)') AS ?cs_definition)
  BIND (CONCAT(UCASE(SUBSTR(?collection, 1, 1)), SUBSTR(?collection, 2)) AS ?collection_capitalize)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/procedure/', ?collection_capitalize, 'Procedure')) AS ?URI2)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/procedure/', ?collection_capitalize, 'Procedure', 'Collection')) AS ?URI3)
  BIND (STRLANG(CONCAT('Procedures for ', ?collection_capitalize, ' - codelist class'),"en")  AS ?c_label)
  BIND (STRLANG(CONCAT('This code list provides analysis procedures for ', ?collection_capitalize, '.'), "en") AS ?c_comment)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/procedure/', ?collection, 'Procedure', '-', ?concept)) AS ?oneof)
  BIND (IF(?concept != '', ?oneof, ?nothing) AS ?c_oneof)
  BIND (STRLANG(?label, "en")  AS ?i_label)
  BIND (IF(?notation != '', ?notation, ?nothing) AS ?i_notation)
  BIND (IF(?definition != '', ?definition, ?nothing) AS ?i_description)
  BIND (IF(?reference != '', URI(?reference), ?nothing)  AS ?i_reference)
  BIND (IF(?citation != '', ?citation, ?nothing) AS ?i_citation)
  BIND (IF(?parent_concept = '', ?URI1, ?nothing) AS ?top_URI)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/procedure/', ?collection, 'Procedure', '-', ?parent_concept)) AS ?parentURI)
  BIND (IF(?parent_concept != '', ?parentURI, ?nothing) AS ?broaderURI)
}
