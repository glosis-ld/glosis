  "@id" : "http://w3id.org/glosis/model/layerhorizon/CadmiumTotalElements",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Total cadmium includes all forms of cadmium in soil, such as bound, mineralized, and free forms. It is used to assess long-term contamination levels. Source: Kabata-Pendias, A., & Pendias, H. (2001). Trace Elements in Soils and Plants."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
