@prefix : <http://w3id.org/glosis/model/siteplot#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://w3id.org/glosis/model/siteplot#> .

<http://w3id.org/glosis/model/siteplot> rdf:type owl:Ontology ;
                                         owl:versionIRI <http://w3id.org/glosis/model/siteplot/2.0.0> ;
                                         owl:imports <http://w3id.org/glosis/model/codelists/properties/> ,
                                                     <http://w3id.org/glosis/model/codelists/results/> ,
                                                     <http://w3id.org/glosis/model/common/> ,
                                                     <http://w3id.org/glosis/model/iso28258/2013/> ,
                                                     <http://www.w3.org/ns/sosa/> ,
                                                     <http://www.w3.org/ns/ssn/> ;
                                         <http://purl.org/dc/terms/creator> _:genid-nodeid-node1juk5lc1mx1957 ,
                                                                            _:genid1 ,
                                                                            _:genid3 ;
                                         <http://purl.org/dc/terms/description> "GLOSIS ontology has been created from the data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en ;
                                         <http://purl.org/dc/terms/rights> "This ontology is distributed under Creative Commons Attribution-NonCommercial-ShareAlike 3.0 IGO License - https://creativecommons.org/licenses/by-nc-sa/3.0/igo/"@en ;
                                         <http://purl.org/dc/terms/source> "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en ;
                                         <http://purl.org/dc/terms/title> "GlOSIS Ontology: Site-Plot module"@en ;
                                         rdfs:comment "This module contains the classes and properties to describe soil sites (a defined area which is subject to a soil quality investigation) and soil plots (an elementary area where individual observations are made and/or samples are taken)."@en ;
                                         owl:versionInfo "2.0.0" .

_:genid1 <http://schema.org/affiliation> [ <http://xmlns.com/foaf/0.1/name> "PSNC"
                                          ] ;
          rdfs:seeAlso <http://orcid.org/0000-0003-4289-4922> ;
          <http://xmlns.com/foaf/0.1/name> "Raul Palma" .

_:genid3 <http://schema.org/affiliation> [ <http://xmlns.com/foaf/0.1/name> "PSNC"
                                          ] ;
          <http://xmlns.com/foaf/0.1/name> "Bogusz Janiak" .

#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/glosis/model/siteplot/altitude
<http://w3id.org/glosis/model/siteplot/altitude> rdf:type owl:ObjectProperty ;
                                                 rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                                                 rdfs:comment "Refers to the vertical distance above or below a reference point, typically sea level, at which a soil sample or observation is located." ;
                                                 rdfs:label "altitude"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en .


###  http://w3id.org/glosis/model/siteplot/country
<http://w3id.org/glosis/model/siteplot/country> rdf:type owl:ObjectProperty ;
                                                rdfs:range <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/Alpha2Code> ;
                                                rdfs:comment "Refers to the national jurisdiction or geopolitical region in which the soil sample or observation was taken, indicating the broader context of the location" ;
                                                rdfs:label "country"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en .


###  http://w3id.org/glosis/model/siteplot/positionalAccuracy
<http://w3id.org/glosis/model/siteplot/positionalAccuracy> rdf:type owl:ObjectProperty ;
                                                           rdfs:range <http://www.w3.org/ns/ssn/Property> ;
                                                           rdfs:comment "Refers to the degree to which the geographic location of a soil sample or observation corresponds to its true location, often expressed as a range or error margin." ;
                                                           rdfs:label "positionalAccuracy"@en ;
                                                           <http://www.w3.org/2004/02/skos/core#definition> "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en .


###  http://w3id.org/glosis/model/siteplot/responsibleOrganization
<http://w3id.org/glosis/model/siteplot/responsibleOrganization> rdf:type owl:ObjectProperty ;
                                                                rdfs:range <http://xmlns.com/foaf/0.1/Agent> ;
                                                                rdfs:comment "Refers to the entity or organization accountable for collecting, managing, or providing soil data or related information." ;
                                                                rdfs:label "responsibleOrganization"@en ;
                                                                <http://www.w3.org/2004/02/skos/core#definition> "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en .


###  http://w3id.org/glosis/model/siteplot/timestamp
<http://w3id.org/glosis/model/siteplot/timestamp> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://w3id.org/glosis/model/siteplot/cropDescription
<http://w3id.org/glosis/model/siteplot/cropDescription> rdf:type owl:DatatypeProperty ;
                                                        rdfs:range xsd:string ;
                                                        rdfs:comment "Description of crops at the site"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"@en .


###  http://w3id.org/glosis/model/siteplot/landUseCropRotation
<http://w3id.org/glosis/model/siteplot/landUseCropRotation> rdf:type owl:DatatypeProperty ;
                                                            rdfs:range xsd:string ;
                                                            rdfs:comment "Description of crop rotation at the site"@en ;
                                                            rdfs:label "landUseCropRotation"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/landUseRemark
<http://w3id.org/glosis/model/siteplot/landUseRemark> rdf:type owl:DatatypeProperty ;
                                                      rdfs:range xsd:string ;
                                                      rdfs:comment "Description of land use at the site"@en ;
                                                      rdfs:label "landUseRemark"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/location
<http://w3id.org/glosis/model/siteplot/location> rdf:type owl:DatatypeProperty ;
                                                 rdfs:range xsd:string ;
                                                 rdfs:comment "Refers to the geographic location or descriptive details that pinpoint where a soil sample or observation is made." ;
                                                 rdfs:label "location"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en .


###  http://w3id.org/glosis/model/siteplot/mapSheetID
<http://w3id.org/glosis/model/siteplot/mapSheetID> rdf:type owl:DatatypeProperty ;
                                                   rdfs:range xsd:string ;
                                                   rdfs:comment "Refers to the unique identifier assigned to a specific map sheet or map section, which is used for referencing detailed geographic or soil data in mapping systems." ;
                                                   rdfs:label "mapSheetID"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en .


###  http://w3id.org/glosis/model/siteplot/parentRemarks
<http://w3id.org/glosis/model/siteplot/parentRemarks> rdf:type owl:DatatypeProperty ;
                                                      rdfs:range xsd:string ;
                                                      rdfs:comment "Remarks on the parent material"@en ;
                                                      rdfs:label "parentRemarks"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/physiographyDescription
<http://w3id.org/glosis/model/siteplot/physiographyDescription> rdf:type owl:DatatypeProperty ;
                                                                rdfs:range xsd:string ;
                                                                rdfs:comment "Description of the local physiography"@en ;
                                                                rdfs:label "physiographyDescription"@en ;
                                                                <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/remarks
<http://w3id.org/glosis/model/siteplot/remarks> rdf:type owl:DatatypeProperty ;
                                                rdfs:range xsd:string ;
                                                rdfs:comment "Refer to additional comments or annotations about a soil sample, observation, or dataset, often providing context or explanations for the data." ;
                                                rdfs:label "remarks"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en .


###  http://w3id.org/glosis/model/siteplot/timestamp
<http://w3id.org/glosis/model/siteplot/timestamp> rdf:type owl:DatatypeProperty ;
                                                  rdfs:range xsd:dateTime .


###  http://w3id.org/glosis/model/siteplot/vegetationDescription
<http://w3id.org/glosis/model/siteplot/vegetationDescription> rdf:type owl:DatatypeProperty ;
                                                              rdfs:range xsd:string ;
                                                              rdfs:comment "Description of vegetation at the site"@en ;
                                                              rdfs:label "vegetationDescription"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


