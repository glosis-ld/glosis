  }, {
    "@id" : "http://w3id.org/glosis/model/unit/"
  }, {
    "@id" : "http://www.ontology-of-units-of-measure.org/resource/om-2/"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/"
  }, {
    "@id" : "http://www.w3.org/ns/ssn/"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "http://w3id.org/glosis/model/layerhorizon/2.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "2.0.0"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/AcidityExchangeable",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Exchangeable acidity refers to the acidic cations (like hydrogen and aluminum) that are adsorbed onto the soil’s exchange sites and can be replaced by other cations. It influences soil pH and plant growth. High exchangeable acidity is common in highly weathered and acidic soils. Source: Brady, N.C., & Weil, R.R. (2017). The Nature and Properties of Soils."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AcidityExchangeable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/glosis/model/layerhorizon/PhysioChemical"
  }, {
    "@id" : "_:genid71"
  }, {
    "@id" : "_:genid72"
  }, {
    "@id" : "_:genid73"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/AcidityExchangeableValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AcidityExchangeableValue"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/glosis/model/layerhorizon/PhysioChemicalValue"
  }, {
    "@id" : "_:genid74"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/AluminiumExchangeableBases",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This refers to aluminum ions that occupy exchangeable sites within soil colloids. Exchangeable aluminum is significant because it becomes toxic to plants in acidic soils, affecting root development. Source: Soil Science Society of America (SSSA) Glossary."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AluminiumExchangeableBases"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/glosis/model/layerhorizon/PhysioChemical"
  }, {
    "@id" : "_:genid75"
  }, {
    "@id" : "_:genid76"
  }, {
    "@id" : "_:genid77"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/AluminiumExchangeableBasesValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AluminiumExchangeableBasesValue"
  } ],
