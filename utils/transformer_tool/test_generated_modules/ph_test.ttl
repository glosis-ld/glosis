glosis_pch:physioChemicalPropertyCode-Nittot a dbo:ChemicalCompound,
        dbo:ChemicalSubstance,
        glosis_pch:PhysioChemicalPropertyCode,
        skos:Concept ;
    dbo:inchi "1S/N2/c1-2" ;
