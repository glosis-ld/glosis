        glosis_res:cropClassValueCode-Ve ;
    skos:note "This code list provides the CropClassValue codes."@en ;
    skos:prefLabel "Code list for CropClassValue - codelist class"@en .

glosis_res:ErosionActivityPeriodValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:ErosionActivityPeriodValueCode ;
    skos:definition "The period of activity of accelerated erosion or deposition is described using the recommended classes. See more in Guidelines for Soil Description issued by the FAO: table 19" ;
    skos:member glosis_res:erosionActivityPeriodValueCode-A,
        glosis_res:erosionActivityPeriodValueCode-H,
        glosis_res:erosionActivityPeriodValueCode-N,
        glosis_res:erosionActivityPeriodValueCode-R,
        glosis_res:erosionActivityPeriodValueCode-X ;
    skos:note "This code list provides the ErosionActivityPeriodValue codes."@en ;
    skos:prefLabel "Code list for ErosionActivityPeriodValue - codelist class"@en .

glosis_res:ErosionAreaAffectedValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:ErosionAreaAffectedValueCode ;
    skos:definition "Classification of total area affected by erosion and deposition. See more in Guidelines for Soil Description issued by the FAO: table 17" ;
    skos:member glosis_res:erosionAreaAffectedValueCode-0,
        glosis_res:erosionAreaAffectedValueCode-1,
        glosis_res:erosionAreaAffectedValueCode-2,
        glosis_res:erosionAreaAffectedValueCode-3,
        glosis_res:erosionAreaAffectedValueCode-4,
        glosis_res:erosionAreaAffectedValueCode-5 ;
    skos:note "This code list provides the ErosionAreaAffectedValue codes."@en ;
    skos:prefLabel "Code list for ErosionAreaAffectedValue - codelist class"@en .

glosis_res:ErosionCategoryValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:ErosionCategoryValueCode ;
    skos:definition "Erosion can be classified as water or wind erosion and include off-site effects such as deposition, a third major category is mass movements (landslides and related phenomena). See more in Guidelines for Soil Description issued by the FAO: table 16" ;
    skos:member glosis_res:erosionCategoryValueCode-A,
        glosis_res:erosionCategoryValueCode-AD,
        glosis_res:erosionCategoryValueCode-AM,
        glosis_res:erosionCategoryValueCode-AS,
        glosis_res:erosionCategoryValueCode-AZ,
        glosis_res:erosionCategoryValueCode-M,
        glosis_res:erosionCategoryValueCode-N,
        glosis_res:erosionCategoryValueCode-NK,
        glosis_res:erosionCategoryValueCode-W,
        glosis_res:erosionCategoryValueCode-WA,
        glosis_res:erosionCategoryValueCode-WD,
        glosis_res:erosionCategoryValueCode-WG,
        glosis_res:erosionCategoryValueCode-WR,
        glosis_res:erosionCategoryValueCode-WS,
        glosis_res:erosionCategoryValueCode-WT ;
    skos:note "This code list provides the ErosionCategoryValue codes."@en ;
    skos:prefLabel "Code list for ErosionCategoryValue - codelist class"@en .

glosis_res:ErosionDegreeValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:ErosionDegreeValueCode ;
    skos:definition "Classification of erosion, by degree. See more in guidelines for Soil Description issued by the FAO: table 18" ;
    skos:member glosis_res:erosionDegreeValueCode-E,
        glosis_res:erosionDegreeValueCode-M,
        glosis_res:erosionDegreeValueCode-S,
        glosis_res:erosionDegreeValueCode-V ;
    skos:note "This code list provides the ErosionDegreeValue codes."@en ;
    skos:prefLabel "Code list for ErosionDegreeValue - codelist class"@en .

glosis_res:ErosionTotalAreaAffectedValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:ErosionTotalAreaAffectedValueCode ;
    skos:definition "The total area affected by erosion and deposition is estimated following the classes defined by SOTER (FAO, 1995). See more in the Guidelines for Soil Description issued by the FAO: table 17" ;
    skos:member glosis_res:erosionTotalAreaAffectedValueCode-0,
        glosis_res:erosionTotalAreaAffectedValueCode-1,
        glosis_res:erosionTotalAreaAffectedValueCode-2,
        glosis_res:erosionTotalAreaAffectedValueCode-3,
        glosis_res:erosionTotalAreaAffectedValueCode-4,
        glosis_res:erosionTotalAreaAffectedValueCode-5 ;
    skos:note "This code list provides the ErosionTotalAreaAffectedValue codes."@en ;
    skos:prefLabel "Code list for ErosionTotalAreaAffectedValue - codelist class"@en .

glosis_res:FloodDurationValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:FloodDurationValueCode ;
    skos:definition "Related to the amount of time an area remains inundated by floodwater.  This metric is important because it helps assess the extent of waterlogging and its impact on soil properties, particularly in terms of oxygen availability and soil aeration. Flood duration affects the mobility of nutrients and contaminants within the soil, influencing both agricultural productivity and environmental quality. Longer flood durations can also lead to changes in soil texture and structure due to the continuous movement and deposition of particles during inundation​. Source: Guidance for Flood Risk Analysis and Mapping" ;
    skos:note "This code list provides the FloodDurationValue codes."@en ;
    skos:prefLabel "Code list for FloodDurationValue - codelist class"@en .

glosis_res:FloodFrequencyValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:FloodFrequencyValueCode ;
    skos:definition "Refers to the statistical analysis of the occurrence of floods at a particular location over a defined time period. It often involves calculating the recurrence intervals or return periods of flood events, which are typically used to understand how often a specific flood magnitude (like a 100-year flood) is likely to occur. Source: Introduction to Flood Frequency Analysis" ;
    skos:note "This code list provides the FloodFrequencyValue codes."@en ;
    skos:prefLabel "Code list for FloodFrequencyValue - codelist class"@en .

glosis_res:FragmentCoverValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:FragmentCoverValueCode ;
    skos:definition "Coarse surface fragments, including those partially exposed, should be described in terms of percentage of surface coverage and of size of the fragments. See more in Guidelines for Soil Description issued by the FAO: table 15,1" ;
    skos:member glosis_res:fragmentCoverValueCode-A,
        glosis_res:fragmentCoverValueCode-C,
        glosis_res:fragmentCoverValueCode-D,
        glosis_res:fragmentCoverValueCode-F,
        glosis_res:fragmentCoverValueCode-M,
        glosis_res:fragmentCoverValueCode-N,
        glosis_res:fragmentCoverValueCode-V ;
    skos:note "This code list provides the FragmentCoverValue codes."@en ;
    skos:prefLabel "Code list for FragmentCoverValue - codelist class"@en .

glosis_res:FragmentsClassValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:FragmentsClassValueCode ;
    skos:definition "Horizon properties encountered in a global data compilation programme. See more in ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3" ;
    skos:member glosis_res:fragmentsClassValueCode-FGF1,
        glosis_res:fragmentsClassValueCode-FGF2,
        glosis_res:fragmentsClassValueCode-FGF3,
        glosis_res:fragmentsClassValueCode-FGF4,
        glosis_res:fragmentsClassValueCode-FGT,
        glosis_res:fragmentsClassValueCode-FV1,
