  }, {
    "@id" : "_:genid284"
  }, {
    "@id" : "_:genid288"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 68"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/CoatingNature",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coating nature refers to the composition of coatings, which could include clay, organic matter, carbonates, or iron oxides. This indicates pedogenic processes. Source: Soil Classification: A Global Desk Reference (Eswaran et al., 2003)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CoatingNature"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "_:genid289"
  }, {
