  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This is the bulk density measurement of peat soils, which are rich in organic matter. Peat soils have very low bulk density due to their high porosity and organic composition. Source: Soil Classification: A Global Desk Reference (Eswaran et al., 2003)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
