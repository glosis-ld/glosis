  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Total calcium refers to the total amount of calcium present in the soil, including calcium in minerals, organic matter, and soil solution. Source: Soil Fertility and Nutrient Management (Havlin et al., 2016)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
