                                     :CoatingContrastValueCode ,
                                     <http://www.w3.org/2004/02/skos/core#Concept> ;
                            <http://purl.org/dc/terms/isPartOf> :CoatingContrastValueCollection ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Surface of coating shows only little contrast in colour, smoothness or any other property to the adjacent surface. Fine sand grains are readily apparent in the cutan. Lamellae are less than 2 mm thick." ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                            <http://www.w3.org/2004/02/skos/core#notation> "F" ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Faint"@en .


