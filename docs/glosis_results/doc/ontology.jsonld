    "@value" : "FI"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Firm"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/consistenceMoistValueCode-FR",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/ConsistenceMoistValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
