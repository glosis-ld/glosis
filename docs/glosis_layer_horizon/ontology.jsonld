  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Peat decomposition assesses the degree to which organic material in peat soils has broken down. It is described in terms of fibric, hemic, or sapric decomposition stages. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."
