        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/CoatingContrastValueCollection"/>
        <skos:definition>Surface of coating is distinctly smoother or different in colour from the adjacent surface. Fine sand grains are enveloped in the coating but their outlines are still visible. Lamellae are 2–5 mm thick.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>D</skos:notation>
        <skos:prefLabel xml:lang="en">Distinct</skos:prefLabel>
