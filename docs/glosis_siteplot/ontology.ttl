#################################################################

###  http://qudt.org/schema/qudt/Unit
<http://qudt.org/schema/qudt/Unit> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/CropClassValueCode
<http://w3id.org/glosis/model/codelists/results/CropClassValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/ErosionActivityPeriodValueCode
<http://w3id.org/glosis/model/codelists/results/ErosionActivityPeriodValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/ErosionAreaAffectedValueCode
<http://w3id.org/glosis/model/codelists/results/ErosionAreaAffectedValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/ErosionCategoryValueCode
<http://w3id.org/glosis/model/codelists/results/ErosionCategoryValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/ErosionDegreeValueCode
<http://w3id.org/glosis/model/codelists/results/ErosionDegreeValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/ErosionTotalAreaAffectedValueCode
<http://w3id.org/glosis/model/codelists/results/ErosionTotalAreaAffectedValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/FloodDurationValueCode
<http://w3id.org/glosis/model/codelists/results/FloodDurationValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/FloodFrequencyValueCode
<http://w3id.org/glosis/model/codelists/results/FloodFrequencyValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/HumanInfluenceClassValueCode
<http://w3id.org/glosis/model/codelists/results/HumanInfluenceClassValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/LandUseClassValueCode
<http://w3id.org/glosis/model/codelists/results/LandUseClassValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/LandformComplexValueCode
<http://w3id.org/glosis/model/codelists/results/LandformComplexValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/LithologyValueCode
<http://w3id.org/glosis/model/codelists/results/LithologyValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/MajorLandFormValueCode
<http://w3id.org/glosis/model/codelists/results/MajorLandFormValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/PhysiographyValueCode
<http://w3id.org/glosis/model/codelists/results/PhysiographyValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/RockOutcropsCoverValueCode
<http://w3id.org/glosis/model/codelists/results/RockOutcropsCoverValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/RockOutcropsDistanceValueCode
<http://w3id.org/glosis/model/codelists/results/RockOutcropsDistanceValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/SlopeFormValueCode
<http://w3id.org/glosis/model/codelists/results/SlopeFormValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/SlopeGradientClassValueCode
<http://w3id.org/glosis/model/codelists/results/SlopeGradientClassValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/SlopePathwaysValueCode
<http://w3id.org/glosis/model/codelists/results/SlopePathwaysValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/SurfaceAgeValueCode
<http://w3id.org/glosis/model/codelists/results/SurfaceAgeValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/TextureUnconsolidatedValueCode
<http://w3id.org/glosis/model/codelists/results/TextureUnconsolidatedValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/VegetationClassValueCode
<http://w3id.org/glosis/model/codelists/results/VegetationClassValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/WeatherConditionsValueCode
<http://w3id.org/glosis/model/codelists/results/WeatherConditionsValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/codelists/results/WeatheringValueCode
<http://w3id.org/glosis/model/codelists/results/WeatheringValueCode> rdf:type owl:Class .


###  http://w3id.org/glosis/model/common/SoilDepth
<http://w3id.org/glosis/model/common/SoilDepth> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                      owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                    <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                  )
                                                                                    ]
                                                                ] .


###  http://w3id.org/glosis/model/common/SoilDepthBedrock
<http://w3id.org/glosis/model/common/SoilDepthBedrock> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                             owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                           <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                         )
                                                                                           ]
                                                                       ] .


###  http://w3id.org/glosis/model/common/SoilDepthRootable
<http://w3id.org/glosis/model/common/SoilDepthRootable> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                          owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                              owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                            <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                          )
                                                                                            ]
                                                                        ] .


###  http://w3id.org/glosis/model/common/SoilDepthRootableClass
<http://w3id.org/glosis/model/common/SoilDepthRootableClass> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                               owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                   owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                                 <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                               )
                                                                                                 ]
                                                                             ] .


###  http://w3id.org/glosis/model/common/SoilDepthSampled
<http://w3id.org/glosis/model/common/SoilDepthSampled> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                             owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                           <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                         )
                                                                                           ]
                                                                       ] .


###  http://w3id.org/glosis/model/common/WeatheringFragments
<http://w3id.org/glosis/model/common/WeatheringFragments> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                            owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                              <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                            )
                                                                                              ]
                                                                          ] .


###  http://w3id.org/glosis/model/siteplot/CropClass
<http://w3id.org/glosis/model/siteplot/CropClass> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                    owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/CropClassValueCode>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                    owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                        owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                      <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                    )
                                                                                      ]
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                    owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-cropClassProperty>
                                                                  ] ;
                                                  rdfs:comment "Crop Class refers to the classification system that categorizes different types of crops based on their growth characteristics, climate needs, and agricultural suitability. It is often used to understand how specific crops are adapted to varying soil and climatic conditions, aiding in crop management and agricultural planning. Source: FAO, 'Guidelines for Soil Profile Description'" ;
                                                  rdfs:label "CropClass"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 9"@en .


###  http://w3id.org/glosis/model/siteplot/ErosionActivityPeriod
<http://w3id.org/glosis/model/siteplot/ErosionActivityPeriod> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                                owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/ErosionActivityPeriodValueCode>
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                                owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                    owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                                  <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                                )
                                                                                                  ]
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                                owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-ErosionActivityPeriodProperty>
                                                                              ] ;
                                                              rdfs:comment "This term refers to the time span during which soil erosion activities, such as water or wind erosion, are active. The period typically coincides with certain climatic conditions (like rainy seasons) or land-use activities that contribute to soil degradation. Source: USDA Natural Resources Conservation Service (NRCS)" ;
                                                              rdfs:label "ErosionActivityPeriod"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 19"@en .


###  http://w3id.org/glosis/model/siteplot/ErosionAreaAffected
<http://w3id.org/glosis/model/siteplot/ErosionAreaAffected> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                              owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/ErosionAreaAffectedValueCode>
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                              owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                  owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                                <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                              )
                                                                                                ]
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                              owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-erosionAreaAffectedProperty>
                                                                            ] ;
                                                            rdfs:comment "Erosion Area Affected is the portion of land or soil area that is subject to erosion, either currently or historically. It measures the extent to which soil erosion has impacted the land, often used in land management to prioritize remediation efforts. Source: USDA NRCS, 'Soil Erosion Research and Technology Transfer'" ;
                                                            rdfs:label "ErosionAreaAffected"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 17"@en .


###  http://w3id.org/glosis/model/siteplot/ErosionCategory
<http://w3id.org/glosis/model/siteplot/ErosionCategory> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                          owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/ErosionCategoryValueCode>
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                          owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                              owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                            <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                          )
                                                                                            ]
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                          owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-erosionCategoryProperty>
                                                                        ] ;
                                                        rdfs:comment "This refers to the classification of erosion based on its severity, type (e.g., water, wind), or cause (natural vs. human-induced). Categories help in the assessment and management of erosion risks. Source: FAO, 'Soil Erosion and Conservation'" ;
                                                        rdfs:label "ErosionCategory"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 16"@en .


###  http://w3id.org/glosis/model/siteplot/ErosionDegree
<http://w3id.org/glosis/model/siteplot/ErosionDegree> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                        owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/ErosionDegreeValueCode>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                        owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                            owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                          <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                        )
                                                                                          ]
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                        owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-erosionDegreeProperty>
                                                                      ] ;
                                                      rdfs:comment "The degree of erosion refers to the severity of soil erosion, ranging from slight to severe, which helps in determining soil conservation needs and planning soil restoration efforts. Source: FAO, 'Soil Erosion and Conservation'" ;
                                                      rdfs:label "ErosionDegree"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 18"@en .


###  http://w3id.org/glosis/model/siteplot/ErosionTotalAreaAffected
<http://w3id.org/glosis/model/siteplot/ErosionTotalAreaAffected> rdf:type owl:Class ;
                                                                 rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                                   owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/ErosionTotalAreaAffectedValueCode>
                                                                                 ] ,
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                       owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                                     <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                                   )
                                                                                                     ]
                                                                                 ] ,
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                                   owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-ErosionTotalAreaAffectedProperty>
                                                                                 ] ;
                                                                 rdfs:comment "This term quantifies the total land area affected by erosion processes, encompassing all zones that have experienced erosion, whether through wind, water, or other agents. Source: USDA NRCS, 'Soil Erosion Research and Technology Transfer'" ;
                                                                 rdfs:label "ErosionTotalAreaAffected"@en ;
                                                                 <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 17"@en .


###  http://w3id.org/glosis/model/siteplot/FloodDuration
<http://w3id.org/glosis/model/siteplot/FloodDuration> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                        owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/FloodDurationValueCode>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                        owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                            owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                          <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                        )
                                                                                          ]
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                        owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-floodDurationProperty>
                                                                      ] ;
                                                      rdfs:comment "Flood duration measures the length of time that an area remains inundated with water during a flood event. It is an important metric in determining the potential impacts on soil structure and fertility. Source: USGS, 'Floodplain Management'" ;
                                                      rdfs:label "FloodDuration"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 174"@en .


###  http://w3id.org/glosis/model/siteplot/FloodFrequency
<http://w3id.org/glosis/model/siteplot/FloodFrequency> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                         owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/FloodFrequencyValueCode>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                             owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                           <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                         )
                                                                                           ]
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                         owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-FloodFrequencyProperty>
                                                                       ] ;
                                                       rdfs:comment "Flood frequency indicates how often a specific area is expected to experience flooding over a given time period. This is used in flood risk assessments and land-use planning. Source: USGS, 'Floodplain Management'" ;
                                                       rdfs:label "FloodFrequency"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 174"@en .


###  http://w3id.org/glosis/model/siteplot/GL_Plot
<http://w3id.org/glosis/model/siteplot/GL_Plot> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://w3id.org/glosis/model/iso28258/2013/Plot> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/altitude> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/country> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/positionalAccuracy> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/responsibleOrganization> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/timestamp> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/location> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/mapSheetID> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/remarks> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ;
                                                rdfs:comment "Specialization for GloSIS of ISO iso28258 Plot soil feature type, defined as an elementary area where individual observations are made and/or samples are taken" ;
                                                rdfs:label "GL_Plot"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en .


###  http://w3id.org/glosis/model/siteplot/GL_Site
<http://w3id.org/glosis/model/siteplot/GL_Site> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://w3id.org/glosis/model/iso28258/2013/Site> ,
                                                                <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/altitude> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/country> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/positionalAccuracy> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/responsibleOrganization> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/timestamp> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/location> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/mapSheetID> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/glosis/model/siteplot/remarks> ;
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                ] ;
                                                rdfs:comment "Specialization for GloSIS of ISO iso28258 Site soil feature type, defined as an defined area which is subject to a soil quality investigation" ;
                                                rdfs:label "GL_Site"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en .


###  http://w3id.org/glosis/model/siteplot/Geology
<http://w3id.org/glosis/model/siteplot/Geology> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                  owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/LithologyValueCode>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                      owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                    <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                  )
                                                                                    ]
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                  owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-geologyProperty>
                                                                ] ;
                                                rdfs:comment "Geology refers to the study of the Earth's crust, including the minerals and rocks that make up soil and landscape features. Soil properties such as texture and drainage can be heavily influenced by the underlying geology. Source: AGI, 'Geology in Environmental Management'" ;
                                                rdfs:label "Geology"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 12"@en .


###  http://w3id.org/glosis/model/siteplot/GroundwaterDepth
<http://w3id.org/glosis/model/siteplot/GroundwaterDepth> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                           owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                               owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                             <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                           )
                                                                                             ]
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                           owl:allValuesFrom <http://w3id.org/glosis/model/siteplot/GroundwaterDepthValue>
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                           owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-GroundwaterDepthProperty>
                                                                         ] ;
                                                         rdfs:comment "Groundwater depth is the vertical distance from the soil surface to the top of the groundwater table. This depth affects water availability, root penetration, and overall soil health. Source: USDA NRCS, 'Groundwater and Soil'" ;
                                                         rdfs:label "GroundwaterDepth"@en ;
                                                         <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/GroundwaterDepthValue
<http://w3id.org/glosis/model/siteplot/GroundwaterDepthValue> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue> ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://qudt.org/schema/qudt/unit> ;
                                                                                owl:hasValue <http://qudt.org/vocab/unit/CentiM>
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://qudt.org/schema/qudt/numericValue> ;
                                                                                owl:allValuesFrom xsd:float
                                                                              ] ;
                                                              rdfs:label "GroundwaterDepthValue"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/HumanInfluenceClass
<http://w3id.org/glosis/model/siteplot/HumanInfluenceClass> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                              owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/HumanInfluenceClassValueCode>
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                              owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                  owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                                <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                              )
                                                                                                ]
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                              owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-HumanInfluenceClassProperty>
                                                                            ] ;
                                                            rdfs:comment "Human Influence Class refers to a categorization system used to assess the degree of human impact on a given landscape or ecosystem. This can range from undisturbed natural areas to heavily modified environments, influencing soil properties and vegetation cover. Source: FAO, 'Land Degradation Assessment in Drylands'" ;
                                                            rdfs:label "HumanInfluenceClass"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 10"@en .


###  http://w3id.org/glosis/model/siteplot/KoeppenClass
<http://w3id.org/glosis/model/siteplot/KoeppenClass> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                       owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                           owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                         <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                       )
                                                                                         ]
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                       owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-koeppenClassProperty>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasSimpleResult> ;
                                                                       owl:allValuesFrom xsd:string
                                                                     ] ;
                                                     rdfs:comment "The Köppen climate classification system divides the world into climate zones based on temperature, precipitation, and seasonal patterns. Soil characteristics such as moisture content, temperature, and organic matter are heavily influenced by the Köppen climate type of the region. Source: Köppen, W., 'Geiger's Climate Maps'" ;
                                                     rdfs:label "KoeppenClass"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/LandUseBareCover
<http://w3id.org/glosis/model/siteplot/LandUseBareCover> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                           owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                               owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                             <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                           )
                                                                                             ]
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                           owl:allValuesFrom <http://w3id.org/glosis/model/siteplot/LandUseBareCoverValue>
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                           owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-bareCoverAbundanceProperty>
                                                                         ] ;
                                                         rdfs:comment "Land Use Bare Cover refers to the proportion of land area that is devoid of vegetation or artificial cover, such as urban development or barren land. This is a key indicator of soil exposure to erosion and degradation. Source: FAO, 'Land Use and Land Cover Classification'" ;
                                                         rdfs:label "LandUseBareCover"@en ;
                                                         <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/LandUseBareCoverValue
<http://w3id.org/glosis/model/siteplot/LandUseBareCoverValue> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue> ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://qudt.org/schema/qudt/unit> ;
                                                                                owl:hasValue <http://qudt.org/vocab/unit/PERCENT>
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://qudt.org/schema/qudt/numericValue> ;
                                                                                owl:allValuesFrom xsd:integer
                                                                              ] ;
                                                              rdfs:label "LandUseBareCoverValue"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/LandUseClass
<http://w3id.org/glosis/model/siteplot/LandUseClass> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                       owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/LandUseClassValueCode>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                       owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                           owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                         <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                       )
                                                                                         ]
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                       owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-LandUseClassProperty>
                                                                     ] ;
                                                     rdfs:comment "Land Use Class categorizes land based on how it is used, such as agricultural land, forest, industrial, or urban. These classes help in determining soil management practices and conservation measures suitable for the area. Source: FAO, 'World Soil Resources Report'" ;
                                                     rdfs:label "LandUseClass"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 8"@en .


###  http://w3id.org/glosis/model/siteplot/LandUseForest
<http://w3id.org/glosis/model/siteplot/LandUseForest> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                        owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                            owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                          <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                        )
                                                                                          ]
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                        owl:allValuesFrom <http://w3id.org/glosis/model/siteplot/LandUseForestValue>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                        owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-ForestAbundanceProperty>
                                                                      ] ;
                                                      rdfs:comment "Land Use Forest refers to areas primarily designated for forest cover, whether natural or planted. Forest land use is closely tied to soil health, with forest soils typically having high organic matter and beneficial nutrient cycling. Source: FAO, 'Forest Resources Assessment'" ;
                                                      rdfs:label "LandUseForest"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/LandUseForestValue
<http://w3id.org/glosis/model/siteplot/LandUseForestValue> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://qudt.org/schema/qudt/unit> ;
                                                                             owl:hasValue <http://qudt.org/vocab/unit/PERCENT>
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://qudt.org/schema/qudt/numericValue> ;
                                                                             owl:allValuesFrom xsd:integer
                                                                           ] ;
                                                           rdfs:label "LandUseForestValue"@en ;
                                                           <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/LandUseGrass
<http://w3id.org/glosis/model/siteplot/LandUseGrass> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                       owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                           owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                         <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                       )
                                                                                         ]
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                       owl:allValuesFrom <http://w3id.org/glosis/model/siteplot/LandUseGrassValue>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                       owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-grassAbundanceProperty>
                                                                     ] ;
                                                     rdfs:comment "Land Use Grass refers to land areas that are covered by grasslands or pastures. These areas are often used for grazing and agricultural production, and the soil can vary in quality depending on management practices and grazing intensity. Source: FAO, 'Grassland Ecosystems and Management'" ;
                                                     rdfs:label "LandUseGrass"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/LandUseGrassValue
<http://w3id.org/glosis/model/siteplot/LandUseGrassValue> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://qudt.org/schema/qudt/unit> ;
                                                                            owl:hasValue <http://qudt.org/vocab/unit/PERCENT>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://qudt.org/schema/qudt/numericValue> ;
                                                                            owl:allValuesFrom xsd:integer
                                                                          ] ;
                                                          rdfs:label "LandUseGrassValue"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/LandUsePavedCover
<http://w3id.org/glosis/model/siteplot/LandUsePavedCover> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                            owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                              <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                            )
                                                                                              ]
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                            owl:allValuesFrom <http://w3id.org/glosis/model/siteplot/LandUsePavedCoverValue>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                            owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-PavedAbundanceProperty>
                                                                          ] ;
                                                          rdfs:comment "Land Use Paved Cover indicates areas where the natural soil has been covered by impervious surfaces such as roads, buildings, or parking lots. This typically leads to increased runoff and reduced soil infiltration capacity. Source: FAO, 'Urban Soil Management'" ;
                                                          rdfs:label "LandUsePavedCover"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/LandUsePavedCoverValue
<http://w3id.org/glosis/model/siteplot/LandUsePavedCoverValue> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue> ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <http://qudt.org/schema/qudt/unit> ;
                                                                                 owl:hasValue <http://qudt.org/vocab/unit/PERCENT>
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <http://qudt.org/schema/qudt/numericValue> ;
                                                                                 owl:allValuesFrom xsd:integer
                                                                               ] ;
                                                               rdfs:label "LandUsePavedCoverValue"@en ;
                                                               <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/LandUseShrubs
<http://w3id.org/glosis/model/siteplot/LandUseShrubs> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                        owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                            owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                          <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                        )
                                                                                          ]
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                        owl:allValuesFrom <http://w3id.org/glosis/model/siteplot/LandUseShrubsValue>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                        owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-ShrubsAbundanceProperty>
                                                                      ] ;
                                                      rdfs:comment "Land Use Shrubs refers to land areas where shrubs dominate the vegetation cover. Shrubs can influence soil properties by stabilizing the soil and contributing to nutrient cycling, particularly in arid and semi-arid areas. Source: FAO, 'Vegetation and Land Use in Arid Zones'" ;
                                                      rdfs:label "LandUseShrubs"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/LandUseShrubsValue
<http://w3id.org/glosis/model/siteplot/LandUseShrubsValue> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://qudt.org/schema/qudt/unit> ;
                                                                             owl:hasValue <http://qudt.org/vocab/unit/PERCENT>
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://qudt.org/schema/qudt/numericValue> ;
                                                                             owl:allValuesFrom xsd:integer
                                                                           ] ;
                                                           rdfs:label "LandUseShrubsValue"@en ;
                                                           <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/LandformComplex
<http://w3id.org/glosis/model/siteplot/LandformComplex> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                          owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/LandformComplexValueCode>
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                          owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                              owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                            <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                          )
                                                                                            ]
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                          owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-landformComplexProperty>
                                                                        ] ;
                                                        rdfs:comment "Landform Complex refers to a landscape unit composed of multiple interrelated landforms, such as hills, valleys, and plains. This classification helps in understanding soil types, hydrology, and erosion risks within a region. Source: USDA NRCS, 'Soil Survey Manual'" ;
                                                        rdfs:label "LandformComplex"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 5"@en .


###  http://w3id.org/glosis/model/siteplot/Lithology
<http://w3id.org/glosis/model/siteplot/Lithology> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                    owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/LithologyValueCode>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                    owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                        owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                      <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                    )
                                                                                      ]
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                    owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-LithologyProperty>
                                                                  ] ;
                                                  rdfs:comment "Lithology is the study and description of the physical characteristics of rocks, particularly in terms of their mineral content and texture. This directly impacts the soil properties above them, influencing drainage, fertility, and root growth. Source: AGI, 'Encyclopedia of Geology'" ;
                                                  rdfs:label "Lithology"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 12"@en .


###  http://w3id.org/glosis/model/siteplot/MajorLandForm
<http://w3id.org/glosis/model/siteplot/MajorLandForm> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                        owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/MajorLandFormValueCode>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                        owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                            owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                          <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                        )
                                                                                          ]
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                        owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-MajorLandFormProperty>
                                                                      ] ;
                                                      rdfs:comment "Major Land Form refers to large-scale natural land features, such as mountains, valleys, plateaus, and plains, that significantly influence soil formation, hydrology, and land use. These landforms provide important context for understanding soil properties and landscape behavior. Source: FAO, 'World Soil Resources Report'" ;
                                                      rdfs:label "MajorLandForm"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 4"@en .


###  http://w3id.org/glosis/model/siteplot/ParentDeposition
<http://w3id.org/glosis/model/siteplot/ParentDeposition> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                           owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/ErosionCategoryValueCode>
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                           owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                               owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                             <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                           )
                                                                                             ]
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                           owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-parentDepositionProperty>
                                                                         ] ;
                                                         rdfs:comment "Parent Deposition refers to the process through which the parent material (e.g., sediment or rock) that forms the soil is deposited. This process can significantly influence soil texture, structure, and fertility. Source: USDA NRCS, 'Soil Genesis and Classification'" ;
                                                         rdfs:label "ParentDeposition"@en ;
                                                         <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 16"@en .


###  http://w3id.org/glosis/model/siteplot/ParentLithology
<http://w3id.org/glosis/model/siteplot/ParentLithology> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                          owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/LithologyValueCode>
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                          owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                              owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                            <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                          )
                                                                                            ]
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                          owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-parentLithologyProperty>
                                                                        ] ;
                                                        rdfs:comment "Parent Lithology is the geological composition of the parent material from which the soil forms, including its mineral content and structure. The lithology of the parent material has a direct impact on the chemical and physical properties of the soil. Source: AGI, 'Encyclopedia of Geology'" ;
                                                        rdfs:label "ParentLithology"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 12"@en .


###  http://w3id.org/glosis/model/siteplot/ParentTextureUnconsolidated
<http://w3id.org/glosis/model/siteplot/ParentTextureUnconsolidated> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                                      owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/TextureUnconsolidatedValueCode>
                                                                                    ] ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                                      owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                          owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                                        <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                                      )
                                                                                                        ]
                                                                                    ] ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                                      owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-parentTextureUnconsolidatedProperty>
                                                                                    ] ;
                                                                    rdfs:comment "Parent Texture Unconsolidated refers to the texture of the parent material (e.g., sediment, loose rock) that has not yet been cemented or consolidated into solid rock. This texture influences the soil’s permeability, drainage, and overall fertility. Source: USDA NRCS, 'Soil Genesis and Classification'" ;
                                                                    rdfs:label "ParentTextureUnconsolidated"@en .


###  http://w3id.org/glosis/model/siteplot/Physiography
<http://w3id.org/glosis/model/siteplot/Physiography> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                       owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/PhysiographyValueCode>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                       owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                           owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                         <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                       )
                                                                                         ]
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                       owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-physiographyProperty>
                                                                     ] ;
                                                     rdfs:comment "Physiography refers to the physical features and landforms of the Earth's surface, including the shape, structure, and distribution of mountains, valleys, plateaus, and plains. These features influence soil formation, drainage, and the distribution of vegetation. Source: FAO, 'Soil Geography and Mapping'" ;
                                                     rdfs:label "Physiography"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: figure 2"@en .


###  http://w3id.org/glosis/model/siteplot/RockOutcropsCover
<http://w3id.org/glosis/model/siteplot/RockOutcropsCover> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                            owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/RockOutcropsCoverValueCode>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                            owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                              <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                            )
                                                                                              ]
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                            owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-rockOutcropsCoverProperty>
                                                                          ] ;
                                                          rdfs:comment "Rock Outcrops Cover refers to the proportion of an area where bedrock or exposed rock outcrops are visible at the surface. These outcrops can influence soil development by limiting soil depth and affecting water retention and nutrient cycling. Source: USDA NRCS, 'Soil Survey Manual'" ;
                                                          rdfs:label "RockOutcropsCover"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 14,1"@en .


###  http://w3id.org/glosis/model/siteplot/RockOutcropsDistance
<http://w3id.org/glosis/model/siteplot/RockOutcropsDistance> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                               owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/RockOutcropsDistanceValueCode>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                               owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                   owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                                 <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                               )
                                                                                                 ]
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                               owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-RockOutcropsDistanceProperty>
                                                                             ] ;
                                                             rdfs:comment "Rock Outcrops Distance measures the distance from a specific point or area to the nearest exposed rock outcrop. This is important for understanding the underlying geology and potential impacts on soil properties, such as drainage and nutrient availability. Source: FAO, 'Soil Formation and Classification'" ;
                                                             rdfs:label "RockOutcropsDistance"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 14,2"@en .


###  http://w3id.org/glosis/model/siteplot/SlopeForm
<http://w3id.org/glosis/model/siteplot/SlopeForm> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                    owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/SlopeFormValueCode>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                    owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                        owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                      <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                    )
                                                                                      ]
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                    owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-slopeFormProperty>
                                                                  ] ;
                                                  rdfs:comment "Weathering Rock Property describes the extent to which rocks in an area have undergone physical, chemical, or biological weathering, breaking down into smaller particles that contribute to soil formation. This property influences the mineral content of the soil, affecting its fertility, structure, and drainage characteristics. Source: AGI, 'Encyclopedia of Geology'" ;
                                                  rdfs:label "SlopeForm"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 6"@en .


###  http://w3id.org/glosis/model/siteplot/SlopeGradientClass
<http://w3id.org/glosis/model/siteplot/SlopeGradientClass> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                             owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/SlopeGradientClassValueCode>
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                             owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                 owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                               <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                             )
                                                                                               ]
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                             owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-slopeGradientClassProperty>
                                                                           ] ;
                                                           rdfs:comment "Slope Gradient Class is a classification system that categorizes slopes based on their steepness. This is typically done by dividing slopes into classes such as gentle, moderate, and steep, with steeper slopes being more prone to erosion. Source: FAO, 'Soil Erosion and Conservation'" ;
                                                           rdfs:label "SlopeGradientClass"@en ;
                                                           <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 7"@en .


###  http://w3id.org/glosis/model/siteplot/SlopeGradientNumeric
<http://w3id.org/glosis/model/siteplot/SlopeGradientNumeric> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                               owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                   owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                                 <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                               )
                                                                                                 ]
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                               owl:allValuesFrom <http://w3id.org/glosis/model/siteplot/SlopeGradientNumericValue>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                               owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-slopeGradientProperty>
                                                                             ] ;
                                                             rdfs:comment "Slope Gradient Numeric provides a numerical value indicating the steepness or gradient of a slope, usually expressed as a percentage. For example, a slope with a 10% gradient rises 10 meters for every 100 meters of horizontal distance. Source: USDA NRCS, 'Soil Survey Manual'" ;
                                                             rdfs:label "SlopeGradientNumeric"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/SlopeGradientNumericValue
<http://w3id.org/glosis/model/siteplot/SlopeGradientNumericValue> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue> ,
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty <http://qudt.org/schema/qudt/unit> ;
                                                                                    owl:hasValue <http://qudt.org/vocab/unit/PERCENT>
                                                                                  ] ,
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty <http://qudt.org/schema/qudt/numericValue> ;
                                                                                    owl:allValuesFrom xsd:float
                                                                                  ] ;
                                                                  rdfs:label "SlopeGradientNumericValue"@en ;
                                                                  <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/SlopeOrientationClass
<http://w3id.org/glosis/model/siteplot/SlopeOrientationClass> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                                owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                    owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                                  <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                                )
                                                                                                  ]
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                                owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-slopeOrientationClassProperty>
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://www.w3.org/ns/sosa/hasSimpleResult> ;
                                                                                owl:allValuesFrom xsd:string
                                                                              ] ;
                                                              rdfs:comment "Slope Orientation Class refers to the classification of the direction a slope faces, such as north-facing, south-facing, east-facing, or west-facing. The orientation of a slope affects its exposure to sunlight, moisture, and wind, which in turn impacts soil temperature, moisture content, and vegetation cover. Source: FAO, 'Soil and Water Conservation'" ;
                                                              rdfs:label "SlopeOrientationClass"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/SlopeOrientationNumeric
<http://w3id.org/glosis/model/siteplot/SlopeOrientationNumeric> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                                  owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                      owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                                    <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                                  )
                                                                                                    ]
                                                                                ] ,
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                                  owl:allValuesFrom <http://w3id.org/glosis/model/siteplot/SlopeOrientationNumericValue>
                                                                                ] ,
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                                  owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-slopeOrientationProperty>
                                                                                ] ;
                                                                rdfs:comment "Slope Orientation Numeric refers to the specific angle or direction of a slope, typically measured in degrees, relative to a cardinal direction (e.g., 0° for north, 90° for east, etc.). This helps in understanding the climatic conditions experienced by the slope, such as sun exposure or wind patterns. Source: USDA NRCS, 'Soil Erosion and Landscape Analysis'" ;
                                                                rdfs:label "SlopeOrientationNumeric"@en ;
                                                                <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/SlopeOrientationNumericValue
<http://w3id.org/glosis/model/siteplot/SlopeOrientationNumericValue> rdf:type owl:Class ;
                                                                     rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue> ,
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <http://qudt.org/schema/qudt/unit> ;
                                                                                       owl:hasValue <http://qudt.org/vocab/unit/DEG>
                                                                                     ] ,
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <http://qudt.org/schema/qudt/numericValue> ;
                                                                                       owl:allValuesFrom xsd:integer
                                                                                     ] ;
                                                                     rdfs:label "SlopeOrientationNumericValue"@en ;
                                                                     <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/SlopePathways
<http://w3id.org/glosis/model/siteplot/SlopePathways> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                        owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/SlopePathwaysValueCode>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                        owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                            owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                          <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                        )
                                                                                          ]
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                        owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-SlopePathwaysProperty>
                                                                      ] ;
                                                      rdfs:comment "Slope Pathways refers to the routes or pathways through which water, sediment, and other materials move across a slope. These pathways are critical for assessing erosion risks, water flow, and sediment transport in sloped areas. Source: FAO, 'Soil Erosion and Conservation'" ;
                                                      rdfs:label "SlopePathways"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: figure 3"@en .


###  http://w3id.org/glosis/model/siteplot/SoilCarbonDensity
<http://w3id.org/glosis/model/siteplot/SoilCarbonDensity> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                            owl:allValuesFrom <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                            owl:allValuesFrom <http://w3id.org/glosis/model/siteplot/SoilCarbonDensityValue>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                            owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-SoilCarbonDensityProperty>
                                                                          ] ;
                                                          rdfs:comment "Soil Carbon Density refers to the amount of carbon stored in a given volume of soil. It is a key indicator of soil organic matter content and plays a significant role in soil fertility, carbon sequestration, and overall ecosystem health. Source: IPCC, 'Guidelines for National Greenhouse Gas Inventories'" ;
                                                          rdfs:label "SoilCarbonDensity"@en .


###  http://w3id.org/glosis/model/siteplot/SoilCarbonDensityValue
<http://w3id.org/glosis/model/siteplot/SoilCarbonDensityValue> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue> ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <http://qudt.org/schema/qudt/unit> ;
                                                                                 owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <http://qudt.org/schema/qudt/numericValue> ;
                                                                                 owl:allValuesFrom xsd:float
                                                                               ] ;
                                                               rdfs:label "SoilCarbonDensityValue"@en .


###  http://w3id.org/glosis/model/siteplot/SurfaceAge
<http://w3id.org/glosis/model/siteplot/SurfaceAge> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                     owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/SurfaceAgeValueCode>
                                                                   ] ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                     owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                         owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                       <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                     )
                                                                                       ]
                                                                   ] ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                     owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-surfaceAgeProperty>
                                                                   ] ;
                                                   rdfs:comment "Surface Age refers to the estimated age of a soil's surface or landform, often linked to the time since the last significant geomorphic event (e.g., glaciation, flooding). This affects the degree of soil development, weathering, and its ability to support vegetation. Source: FAO, 'Soil Formation and Evolution'" ;
                                                   rdfs:label "SurfaceAge"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 13"@en .


###  http://w3id.org/glosis/model/siteplot/TreeDensity
<http://w3id.org/glosis/model/siteplot/TreeDensity> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                      owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                          owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                        <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                      )
                                                                                        ]
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                      owl:allValuesFrom <http://w3id.org/glosis/model/siteplot/TreeDensityValue>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                      owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-TreeDensityProperty>
                                                                    ] ;
                                                    rdfs:comment "Tree Density measures the number of trees per unit area, typically expressed in trees per hectare. This is used to assess forest structure and soil health, as higher tree density can influence soil nutrients, organic matter, and water retention. Source: FAO, 'Forest Resources Assessment'" ;
                                                    rdfs:label "TreeDensity"@en ;
                                                    <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/TreeDensityValue
<http://w3id.org/glosis/model/siteplot/TreeDensityValue> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://qudt.org/schema/qudt/unit> ;
                                                                           owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://qudt.org/schema/qudt/numericValue> ;
                                                                           owl:allValuesFrom xsd:integer
                                                                         ] ;
                                                         rdfs:label "TreeDensityValue"@en ;
                                                         <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1"@en .


###  http://w3id.org/glosis/model/siteplot/VegetationClass
<http://w3id.org/glosis/model/siteplot/VegetationClass> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                          owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/VegetationClassValueCode>
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                          owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                              owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                            <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                          )
                                                                                            ]
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                          owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-VegetationClassProperty>
                                                                        ] ;
                                                        rdfs:comment "Vegetation Class refers to the classification of land areas based on the type of vegetation that grows there, such as forest, grassland, shrubland, or wetland. This classification helps understand soil properties, hydrology, and land management practices. Source: FAO, 'Vegetation and Land Use in Arid Zones'" ;
                                                        rdfs:label "VegetationClass"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 11"@en .


###  http://w3id.org/glosis/model/siteplot/WeatherCurrent
<http://w3id.org/glosis/model/siteplot/WeatherCurrent> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                         owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/WeatherConditionsValueCode>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                             owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                           <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                         )
                                                                                           ]
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                         owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-WeatherConditionsCurrentProperty>
                                                                       ] ;
                                                       rdfs:comment "Weather Current refers to the present atmospheric conditions in a particular area, including factors such as temperature, precipitation, humidity, wind speed, and barometric pressure. These conditions influence soil moisture, temperature, and overall soil health. Source: USGS, 'Meteorological and Soil Interactions'" ;
                                                       rdfs:label "WeatherCurrent"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 2"@en .


###  http://w3id.org/glosis/model/siteplot/WeatherPast
<http://w3id.org/glosis/model/siteplot/WeatherPast> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                                      owl:someValuesFrom <http://w3id.org/glosis/model/codelists/results/WeatherConditionsValueCode>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                      owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                          owl:unionOf ( <http://w3id.org/glosis/model/siteplot/GL_Plot>
                                                                                                        <http://w3id.org/glosis/model/siteplot/GL_Site>
                                                                                                      )
                                                                                        ]
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                                      owl:hasValue <http://w3id.org/glosis/model/codelists/properties/descriptivePropertyCode-weatherConditionsPastProperty>
                                                                    ] ;
                                                    rdfs:comment "Weather Past refers to historical weather data or patterns in a specific region, such as past rainfall, temperature fluctuations, and storm events. This information helps in predicting soil behavior, erosion risk, and vegetation growth patterns over time. Source: USDA NRCS, 'Climate and Soil Interactions'" ;
                                                    rdfs:label "WeatherPast"@en ;
                                                    <http://www.w3.org/2004/02/skos/core#definition> "Guidelines for Soil Description issued by the FAO: table 2"@en .


###  http://w3id.org/glosis/model/siteplot/WeatheringRock
<http://w3id.org/glosis/model/siteplot/WeatheringRock> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
