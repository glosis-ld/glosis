        skos:Concept ;
    skos:definition "Additional code formed by combining HA and VHA" ;
    skos:inScheme glosis_res:consistenceDryValueCode ;
    skos:notation "HVH" ;
    skos:prefLabel "hard to very hard"@en ;
    skos:topConceptOf glosis_res:consistenceDryValueCode .

