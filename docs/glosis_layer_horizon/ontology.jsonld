}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/CementationContinuity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Cementation continuity refers to how continuous or pervasive cemented zones are within the soil profile. It describes the degree to which cemented materials (e.g., silica, iron oxides) bond soil particles together. Source: Soil Survey Manual (USDA, 2017)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
