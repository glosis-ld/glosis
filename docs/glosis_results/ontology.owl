    <!-- http://w3id.org/glosis/model/codelists/results/profileDescriptionStatusValueCode-2 -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/profileDescriptionStatusValueCode-2">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/ProfileDescriptionStatusValueCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/ProfileDescriptionStatusValueCollection"/>
        <skos:definition>No essential elements are missing from the description, sampling or analysis. The number of samples collected is sufficient to characterize all major soil horizons, but may not allow precise definition of all subhorizons, especially in the deeper soil. The profile depth is 80 cm or more, or down to a C or R horizon or layer, which may be shallower. Additional augering and sampling may be required for lower level classification.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:narrower rdf:resource="http://w3id.org/glosis/model/codelists/results/profileDescriptionStatusValueCode-2.1"/>
        <skos:notation>2</skos:notation>
        <skos:prefLabel xml:lang="en">Routine profile description</skos:prefLabel>
    </owl:NamedIndividual>
    


