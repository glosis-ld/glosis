    <!-- http://w3id.org/glosis/model/codelists/results/BiologicalAbundanceValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/BiologicalAbundanceValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalAbundanceValueCode-C"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalAbundanceValueCode-F"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalAbundanceValueCode-M"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalAbundanceValueCode-N"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the BiologicalAbundanceValue codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list for BiologicalAbundanceValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/BiologicalAbundanceValueCollection"/>
        <skos:definition>Classification of the abundance of biological activity. See more in Guidelines for Soil Description issued by the FAO: table 81</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/glosis/model/codelists/results/BiologicalFeaturesValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/BiologicalFeaturesValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalFeaturesValueCode-A"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalFeaturesValueCode-B"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalFeaturesValueCode-BI"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalFeaturesValueCode-BO"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalFeaturesValueCode-C"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalFeaturesValueCode-E"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalFeaturesValueCode-I"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalFeaturesValueCode-P"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/biologicalFeaturesValueCode-T"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the BiologicalFeaturesValue codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list for BiologicalFeaturesValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/BiologicalFeaturesValueCollection"/>
        <skos:definition>Examples of biological features. See more in Guidelines for Soil Description issued by the FAO: table 82</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/glosis/model/codelists/results/BleachedSandValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/BleachedSandValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bleachedSandValueCode-0"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bleachedSandValueCode-1"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bleachedSandValueCode-2"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bleachedSandValueCode-3"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bleachedSandValueCode-4"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the BleachedSandValue codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list for BleachedSandValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/BleachedSandValueCollection"/>
        <skos:definition>Classification of bleached sand characteristics based on the percentage of surface covered. See more in Guidelines for Soil Description issued by the FAO: table 23</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/glosis/model/codelists/results/BoundaryClassificationValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/BoundaryClassificationValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/boundaryClassificationValueCode-C"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/boundaryClassificationValueCode-D"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/boundaryClassificationValueCode-S"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the BoundaryClassificationValue codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list for BoundaryClassificationValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/BoundaryClassificationValueCollection"/>
        <skos:definition>The boundary between mottle and matrix is described as the thickness of the zone within which the colour transition can be located without being in either the mottle or matrix. See more in guidelines for Soil Description issued by the FAO: table 35</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/glosis/model/codelists/results/BoundaryDistinctnessValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/BoundaryDistinctnessValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/boundaryDistinctnessValueCode-A"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/boundaryDistinctnessValueCode-C"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/boundaryDistinctnessValueCode-D"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/boundaryDistinctnessValueCode-G"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the BoundaryDistinctnessValue codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list for BoundaryDistinctnessValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/BoundaryDistinctnessValueCollection"/>
        <skos:definition>The distinctness of the boundary refers to the thickness of the zone in which the horizon boundary can be located without being in one of the adjacent horizons. See more in the  Guidelines for Soil Description issued by the FAO: table 24.1</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/glosis/model/codelists/results/BoundaryTopographyValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/BoundaryTopographyValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/boundaryTopographyValueCode-B"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/boundaryTopographyValueCode-I"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/boundaryTopographyValueCode-S"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/boundaryTopographyValueCode-W"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the BoundaryTopographyValue codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list for BoundaryTopographyValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/BoundaryTopographyValueCollection"/>
        <skos:definition>Classification of horizon boundaries by topography. See more in Guidelines for Soil Description issued by the FAO: table 24,2</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD1"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD2"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD3"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD4"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD5"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the BulkDensityMineralValue codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list for BulkDensityMineralValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCollection"/>
        <skos:definition>Field determinations of bulk density may be obtained by estimating the force required to push a knife into a soil horizon exposed at a field moist pit wall. See more in Guidelines for Soil Description issued by the FAO: table 58</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/glosis/model/codelists/results/BulkDensityPeatValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/BulkDensityPeatValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityPeatValueCode-BD1"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityPeatValueCode-BD2"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityPeatValueCode-BD3"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityPeatValueCode-BD4"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityPeatValueCode-BD5"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the BulkDensityPeatValue codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list for BulkDensityPeatValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityPeatValueCollection"/>
        <skos:definition>Bulk density and volume of solids of organic soils can be estimated after the decomposition stage or the extent of peat drainage. See more in guidelines for Soil Description issued by the FAO: table 59,3</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/glosis/model/codelists/results/CarbonatesContentValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/CarbonatesContentValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesContentValueCode-EX"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesContentValueCode-MO"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesContentValueCode-N"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesContentValueCode-SL"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesContentValueCode-ST"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the CarbonatesContentValue codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list for CarbonatesContentValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/CarbonatesContentValueCollection"/>
        <skos:definition>Classes for the reaction of carbonates in the soil matrix. See more in Guidelines for Soil Description issued by the FAO: table 38</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/glosis/model/codelists/results/CarbonatesFormsValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/CarbonatesFormsValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesFormsValueCode-D"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesFormsValueCode-HC"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesFormsValueCode-HHC"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesFormsValueCode-HL"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesFormsValueCode-M"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesFormsValueCode-PM"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/carbonatesFormsValueCode-SC"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the CarbonatesFormsValue codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list for CarbonatesFormsValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/CarbonatesFormsValueCollection"/>
        <skos:definition>The forms of secondary carbonates in soils are diverse and are considered to be informative for diagnostics of soil genesis. See more in guidelines for Soil Description issued by the FAO: table 39</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/glosis/model/codelists/results/CementationContinuityValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/CementationContinuityValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/cementationContinuityValueCode-B"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/cementationContinuityValueCode-C"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/cementationContinuityValueCode-D"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the CementationContinuityValue codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list for CementationContinuityValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/CementationContinuityValueCollection"/>
        <skos:definition>The occurrence of cementation or compaction in pans or otherwise is described according to its nature, continuity, structure, agent and degree. See more in the guidelines for Soil Description issued by the FAO: table 69</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/glosis/model/codelists/results/CementationDegreeValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/CementationDegreeValueCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
