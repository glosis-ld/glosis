###  http://w3id.org/glosis/model/codelists/properties/textSandPropertyCode-Sa_ISSS
:textSandPropertyCode-Sa_ISSS rdf:type owl:NamedIndividual ,
                                       :TextSandPropertyCode ,
                                       <http://www.w3.org/2004/02/skos/core#Concept> ;
                              <http://purl.org/dc/terms/isPartOf> :TextSandPropertyCollection ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Content of mineral particles with sizes between 0.020-2 mm in soil" ;
                              <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/properties/> ;
                              <http://www.w3.org/2004/02/skos/core#narrower> :textSandPropertyCode-cSa_ISSS ,
