}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/PoresAbundance",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Pore abundance refers to the quantity of voids or pores in the soil that facilitate air and water movement. It impacts root growth and soil aeration. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."
  } ],
