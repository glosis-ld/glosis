    <!-- http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-B -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-B">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCollection"/>
        <skos:definition>Discontinuous spherical or elliptical voids (chambers) of sedimentary origin or formed by compressed air, e.g. gas bubbles in slaking crusts after heavy rainfall. Relatively unimportant in connection with plant growth.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>B</skos:notation>
        <skos:prefLabel xml:lang="en">Vesicular</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-C -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-C">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCollection"/>
        <skos:definition>Elongated voids of faunal or floral origin, mostly tubular in shape and continuous, varying strongly in diameter. When wider than a few centimetres (burrow holes), they are more adequately described under biological activity.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>C</skos:notation>
        <skos:prefLabel xml:lang="en">Channels</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-I -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-I">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCollection"/>
        <skos:definition>Controlled by the fabric, or arrangement, of the soil particles, also known as textural voids. Subdivision possible into simple packing voids, which relate to the packing of sand particles, and compound packing voids, which result from the packing of non-accommodating peds. Predominantly irregular in shape and interconnected, and hard to quantify in the field.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>I</skos:notation>
        <skos:prefLabel xml:lang="en">Interstitial</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-P -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-P">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCollection"/>
