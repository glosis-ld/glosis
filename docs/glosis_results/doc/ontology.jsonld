  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Surface of coating is distinctly smoother or different in colour from the adjacent surface. Fine sand grains are enveloped in the coating but their outlines are still visible. Lamellae are 2–5 mm thick."
  } ],
