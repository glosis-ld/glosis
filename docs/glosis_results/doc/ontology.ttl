###  http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-B
:voidsClassificationValueCode-B rdf:type owl:NamedIndividual ,
                                         :VoidsClassificationValueCode ,
                                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                                <http://purl.org/dc/terms/isPartOf> :VoidsClassificationValueCollection ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Discontinuous spherical or elliptical voids (chambers) of sedimentary origin or formed by compressed air, e.g. gas bubbles in slaking crusts after heavy rainfall. Relatively unimportant in connection with plant growth." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "B" ;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Vesicular"@en .


###  http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-C
:voidsClassificationValueCode-C rdf:type owl:NamedIndividual ,
                                         :VoidsClassificationValueCode ,
                                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                                <http://purl.org/dc/terms/isPartOf> :VoidsClassificationValueCollection ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Elongated voids of faunal or floral origin, mostly tubular in shape and continuous, varying strongly in diameter. When wider than a few centimetres (burrow holes), they are more adequately described under biological activity." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "C" ;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Channels"@en .


###  http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-I
:voidsClassificationValueCode-I rdf:type owl:NamedIndividual ,
                                         :VoidsClassificationValueCode ,
                                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                                <http://purl.org/dc/terms/isPartOf> :VoidsClassificationValueCollection ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Controlled by the fabric, or arrangement, of the soil particles, also known as textural voids. Subdivision possible into simple packing voids, which relate to the packing of sand particles, and compound packing voids, which result from the packing of non-accommodating peds. Predominantly irregular in shape and interconnected, and hard to quantify in the field." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "I" ;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Interstitial"@en .


###  http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-P
:voidsClassificationValueCode-P rdf:type owl:NamedIndividual ,
                                         :VoidsClassificationValueCode ,
                                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                                <http://purl.org/dc/terms/isPartOf> :VoidsClassificationValueCollection ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Most planes are extra-pedal voids, related to accommodating ped surfaces or cracking patterns. They are often not persistent and vary in size, shape and quantity depending on the moisture condition of the soil. Planar voids may be recorded, describing width and frequency." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "P" ;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Planes"@en .


###  http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-V
:voidsClassificationValueCode-V rdf:type owl:NamedIndividual ,
                                         :VoidsClassificationValueCode ,
                                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                                <http://purl.org/dc/terms/isPartOf> :VoidsClassificationValueCollection ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Mostly irregular, equidimensional voids of faunal origin or resulting from tillage or disturbance of other voids. Discontinuous or interconnected. May be quantified in specific cases." ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                                <http://www.w3.org/2004/02/skos/core#notation> "V" ;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Vughs"@en .


###  http://w3id.org/glosis/model/codelists/results/voidsDiameterValueCode-C
:voidsDiameterValueCode-C rdf:type owl:NamedIndividual ,
