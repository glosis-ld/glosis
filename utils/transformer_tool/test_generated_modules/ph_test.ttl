    dbo:pubchem "5359268" ;
    dbprop:inchikey "XAGFODPZIPBFFR-UHFFFAOYSA-N" ;
    rdfs:seeAlso <https://pubchem.ncbi.nlm.nih.gov/compound/5359268> ;
    skos:definition "'Free' aluminium content extracted from amorphous compounds (weathering products) as well as crystaline, primary aluminium compounds (parent material) in the soil." ;
    skos:inScheme glosis_pch:physioChemicalPropertyCode ;
    skos:notation "Aludit" ;
    skos:prefLabel "Aluminium (Al) - dithionite extractable"@en ;
    skos:topConceptOf glosis_pch:physioChemicalPropertyCode .

glosis_pch:physioChemicalPropertyCode-Aluexc a dbo:ChemicalCompound,
        dbo:ChemicalSubstance,
        glosis_pch:PhysioChemicalPropertyCode,
