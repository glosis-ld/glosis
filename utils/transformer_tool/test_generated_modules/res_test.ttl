glosis_res:boundaryClassificationValueCode-C a glosis_res:BoundaryClassificationValueCode,
        skos:Concept ;
    skos:definition "Boundary of mottles 0.5–2 mm" ;
    skos:inScheme glosis_res:boundaryClassificationValueCode ;
    skos:notation "C" ;
