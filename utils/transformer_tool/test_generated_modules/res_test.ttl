    skos:topConceptOf glosis_res:boundaryClassificationValueCode .

glosis_res:boundaryClassificationValueCode-D a glosis_res:BoundaryClassificationValueCode,
        skos:Concept ;
    skos:definition "Boundary of mottles > 2 mm" ;
    skos:inScheme glosis_res:boundaryClassificationValueCode ;
    skos:notation "D" ;
    skos:prefLabel "Diffuse"@en ;
    skos:topConceptOf glosis_res:boundaryClassificationValueCode .

glosis_res:boundaryClassificationValueCode-S a glosis_res:BoundaryClassificationValueCode,
        skos:Concept ;
    skos:definition "Boundary of mottles < 0.5" ;
    skos:inScheme glosis_res:boundaryClassificationValueCode ;
    skos:notation "S" ;
    skos:prefLabel "Sharp"@en ;
    skos:topConceptOf glosis_res:boundaryClassificationValueCode .

glosis_res:boundaryDistinctnessValueCode-A a glosis_res:BoundaryDistinctnessValueCode,
        skos:Concept ;
    skos:definition "0cm–2cm" ;
    skos:inScheme glosis_res:boundaryDistinctnessValueCode ;
    skos:notation "A" ;
    skos:prefLabel "Abrupt"@en ;
    skos:topConceptOf glosis_res:boundaryDistinctnessValueCode .

glosis_res:boundaryDistinctnessValueCode-C a glosis_res:BoundaryDistinctnessValueCode,
        skos:Concept ;
    skos:definition "2cm–5cm" ;
    skos:inScheme glosis_res:boundaryDistinctnessValueCode ;
    skos:notation "C" ;
    skos:prefLabel "Clear"@en ;
    skos:topConceptOf glosis_res:boundaryDistinctnessValueCode .

glosis_res:boundaryDistinctnessValueCode-D a glosis_res:BoundaryDistinctnessValueCode,
        skos:Concept ;
    skos:definition "> 15cm" ;
    skos:inScheme glosis_res:boundaryDistinctnessValueCode ;
    skos:notation "D" ;
    skos:prefLabel "Diffuse"@en ;
    skos:topConceptOf glosis_res:boundaryDistinctnessValueCode .

glosis_res:boundaryDistinctnessValueCode-G a glosis_res:BoundaryDistinctnessValueCode,
        skos:Concept ;
    skos:definition "5cm–15cm" ;
    skos:inScheme glosis_res:boundaryDistinctnessValueCode ;
    skos:notation "G" ;
    skos:prefLabel "Gradual"@en ;
    skos:topConceptOf glosis_res:boundaryDistinctnessValueCode .

glosis_res:boundaryTopographyValueCode-B a glosis_res:BoundaryTopographyValueCode,
        skos:Concept ;
    skos:definition "Discontinuous" ;
    skos:inScheme glosis_res:boundaryTopographyValueCode ;
    skos:notation "B" ;
    skos:prefLabel "Broken"@en ;
    skos:topConceptOf glosis_res:boundaryTopographyValueCode .

glosis_res:boundaryTopographyValueCode-I a glosis_res:BoundaryTopographyValueCode,
        skos:Concept ;
    skos:definition "Pockets more deep than wide" ;
    skos:inScheme glosis_res:boundaryTopographyValueCode ;
    skos:notation "I" ;
    skos:prefLabel "Irregular"@en ;
    skos:topConceptOf glosis_res:boundaryTopographyValueCode .

glosis_res:boundaryTopographyValueCode-S a glosis_res:BoundaryTopographyValueCode,
        skos:Concept ;
    skos:definition "Nearly plane surface" ;
    skos:inScheme glosis_res:boundaryTopographyValueCode ;
    skos:notation "S" ;
    skos:prefLabel "Smooth"@en ;
    skos:topConceptOf glosis_res:boundaryTopographyValueCode .

glosis_res:boundaryTopographyValueCode-W a glosis_res:BoundaryTopographyValueCode,
        skos:Concept ;
    skos:definition "Pockets less deep than wide" ;
    skos:inScheme glosis_res:boundaryTopographyValueCode ;
    skos:notation "W" ;
    skos:prefLabel "Wavy"@en ;
    skos:topConceptOf glosis_res:boundaryTopographyValueCode .

glosis_res:bulkDensityMineralValueCode-BD1 a glosis_res:BulkDensityMineralValueCode,
        skos:Concept ;
    skos:definition "materials with vesicular pores, mineral soils with andic properties. Sample disintegrates at the instant of sampling, many pores visible onthe pit wall. Sample disintegrates at the instant of sampling, many pores visible on the pit wall. Loamy soils with high clay content, clayey soils When dropped, sample disintegrates into numerous fragments, further disintegration of subfragments after application of weak pressure." ;
    skos:inScheme glosis_res:bulkDensityMineralValueCode ;
    skos:notation "BD1" ;
    skos:prefLabel "Many pores, moist materials drop easily out of the auger."@en ;
    skos:topConceptOf glosis_res:bulkDensityMineralValueCode .

glosis_res:bulkDensityMineralValueCode-BD2 a glosis_res:BulkDensityMineralValueCode,
        skos:Concept ;
    skos:definition "Loamy soils with high clay content, clayey soils. When dropped, sample disintegrates into few fragments, further disintegration of subfragments after application of mild pressure." ;
    skos:inScheme glosis_res:bulkDensityMineralValueCode ;
    skos:notation "BD2" ;
    skos:prefLabel "Sample disintegrates into numerous fragments after application of weak pressure."@en ;
    skos:topConceptOf glosis_res:bulkDensityMineralValueCode .

glosis_res:bulkDensityMineralValueCode-BD3 a glosis_res:BulkDensityMineralValueCode,
        skos:Concept ;
    skos:definition "Loamy soils with high clay content, clayey soils. Sample remains mostly intact when dropped, further disintegration possible after application of large pressure." ;
    skos:inScheme glosis_res:bulkDensityMineralValueCode ;
    skos:notation "BD3" ;
    skos:prefLabel "Knife can be pushed into the moist soil with weak pressure, sample disintegrates into few fragments, which may be further divided."@en ;
    skos:topConceptOf glosis_res:bulkDensityMineralValueCode .

glosis_res:bulkDensityMineralValueCode-BD4 a glosis_res:BulkDensityMineralValueCode,
        skos:Concept ;
    skos:definition "Loamy soils with high clay content, clayey soils. Sample remains intact when dropped, no further disintegration after application of very large pressure." ;
    skos:inScheme glosis_res:bulkDensityMineralValueCode ;
    skos:notation "BD4" ;
    skos:prefLabel "Knife penetrates only 1–2 cm into the moist soil, some effort required, sample disintegrates into few fragments, which cannot be subdivided further."@en ;
    skos:topConceptOf glosis_res:bulkDensityMineralValueCode .

glosis_res:bulkDensityMineralValueCode-BD5 a glosis_res:BulkDensityMineralValueCode,
        skos:Concept ;
    skos:definition "Loamy soils with high clay content, clayey soils. Sample remains intact when dropped, no further disintegration after application of very large pressure." ;
    skos:inScheme glosis_res:bulkDensityMineralValueCode ;
    skos:notation "BD5" ;
    skos:prefLabel "Very large pressure necessary to force knife into the soil, no further disintegration of sample."@en ;
    skos:topConceptOf glosis_res:bulkDensityMineralValueCode .

glosis_res:bulkDensityPeatValueCode-BD1 a glosis_res:BulkDensityPeatValueCode,
        skos:Concept ;
    skos:definition "Very low (fibric) class of decomposition: < 0.04g cm-3" ;
    skos:inScheme glosis_res:bulkDensityPeatValueCode ;
    skos:notation "BD1" ;
    skos:prefLabel "Very low"@en ;
    skos:topConceptOf glosis_res:bulkDensityPeatValueCode .

glosis_res:bulkDensityPeatValueCode-BD2 a glosis_res:BulkDensityPeatValueCode,
        skos:Concept ;
    skos:definition "Low (fibric) class of decomposition: 0.04–0.07g cm-3" ;
    skos:inScheme glosis_res:bulkDensityPeatValueCode ;
    skos:notation "BD2" ;
    skos:prefLabel "Low"@en ;
    skos:topConceptOf glosis_res:bulkDensityPeatValueCode .

glosis_res:bulkDensityPeatValueCode-BD3 a glosis_res:BulkDensityPeatValueCode,
        skos:Concept ;
    skos:definition "Moderate(fibric) class of decomposition: 0.07–0.11g cm-3" ;
    skos:inScheme glosis_res:bulkDensityPeatValueCode ;
    skos:notation "BD3" ;
    skos:prefLabel "Moderate low"@en ;
    skos:topConceptOf glosis_res:bulkDensityPeatValueCode .

glosis_res:bulkDensityPeatValueCode-BD4 a glosis_res:BulkDensityPeatValueCode,
        skos:Concept ;
    skos:definition "Moderate(fibric) class of decomposition: 0.11–0.17g cm-3" ;
    skos:inScheme glosis_res:bulkDensityPeatValueCode ;
    skos:notation "BD4" ;
    skos:prefLabel "Moderate high"@en ;
    skos:topConceptOf glosis_res:bulkDensityPeatValueCode .

glosis_res:bulkDensityPeatValueCode-BD5 a glosis_res:BulkDensityPeatValueCode,
        skos:Concept ;
    skos:definition "Strong (hemic) class of decomposition: > 0.17g cm-3" ;
    skos:inScheme glosis_res:bulkDensityPeatValueCode ;
    skos:notation "BD5" ;
    skos:prefLabel "Strong (hemic)"@en ;
    skos:topConceptOf glosis_res:bulkDensityPeatValueCode .

glosis_res:carbonatesContentValueCode-EX a glosis_res:CarbonatesContentValueCode,
        skos:Concept ;
    skos:definition "Extremely strong reaction forming thick foam forms quickly: ≈ > 25" ;
    skos:inScheme glosis_res:carbonatesContentValueCode ;
    skos:notation "EX" ;
    skos:prefLabel "Extremely calcareous"@en ;
    skos:topConceptOf glosis_res:carbonatesContentValueCode .

glosis_res:carbonatesContentValueCode-MO a glosis_res:CarbonatesContentValueCode,
        skos:Concept ;
    skos:definition "Visible effervescence: ≈ 2–10" ;
    skos:inScheme glosis_res:carbonatesContentValueCode ;
    skos:notation "MO" ;
    skos:prefLabel "Moderately calcareous"@en ;
    skos:topConceptOf glosis_res:carbonatesContentValueCode .

glosis_res:carbonatesContentValueCode-N a glosis_res:CarbonatesContentValueCode,
        skos:Concept ;
    skos:definition "No detectable visible or audible effervescence." ;
    skos:inScheme glosis_res:carbonatesContentValueCode ;
    skos:notation "N" ;
    skos:prefLabel "Non-calcareous"@en ;
    skos:topConceptOf glosis_res:carbonatesContentValueCode .

glosis_res:carbonatesContentValueCode-SL a glosis_res:CarbonatesContentValueCode,
        skos:Concept ;
    skos:definition "Audible effervescence but not visible: ≈ 0–2" ;
    skos:inScheme glosis_res:carbonatesContentValueCode ;
    skos:notation "SL" ;
    skos:prefLabel "Slightly calcareous"@en ;
    skos:topConceptOf glosis_res:carbonatesContentValueCode .

glosis_res:carbonatesContentValueCode-ST a glosis_res:CarbonatesContentValueCode,
        skos:Concept ;
    skos:definition "Strong visible effervescence. Bubbles form a low foam: ≈ 10–25" ;
    skos:inScheme glosis_res:carbonatesContentValueCode ;
    skos:notation "ST" ;
    skos:prefLabel "Strongly calcareous"@en ;
    skos:topConceptOf glosis_res:carbonatesContentValueCode .

glosis_res:carbonatesFormsValueCode-D a glosis_res:CarbonatesFormsValueCode,
        skos:Concept ;
    skos:definition "Secondary carbonates in soil in the form of disperse powdery lime" ;
    skos:inScheme glosis_res:carbonatesFormsValueCode ;
    skos:notation "D" ;
    skos:prefLabel "disperse powdery lime"@en ;
    skos:topConceptOf glosis_res:carbonatesFormsValueCode .

glosis_res:carbonatesFormsValueCode-HC a glosis_res:CarbonatesFormsValueCode,
        skos:Concept ;
    skos:definition "Secondary carbonates in soil in the form of hard concretions" ;
    skos:inScheme glosis_res:carbonatesFormsValueCode ;
    skos:notation "HC" ;
    skos:prefLabel "hard concretions"@en ;
    skos:topConceptOf glosis_res:carbonatesFormsValueCode .

glosis_res:carbonatesFormsValueCode-HHC a glosis_res:CarbonatesFormsValueCode,
        skos:Concept ;
    skos:definition "Secondary carbonates in soil in the form of hard hollow concretions" ;
    skos:inScheme glosis_res:carbonatesFormsValueCode ;
    skos:notation "HHC" ;
    skos:prefLabel "hard hollow concretions"@en ;
    skos:topConceptOf glosis_res:carbonatesFormsValueCode .

glosis_res:carbonatesFormsValueCode-HL a glosis_res:CarbonatesFormsValueCode,
        skos:Concept ;
    skos:definition "Secondary carbonates in soil in the form of hard cemented layer or layers of carbonates" ;
    skos:inScheme glosis_res:carbonatesFormsValueCode ;
    skos:notation "HL" ;
    skos:prefLabel "hard cemented layer or layers of carbonates (less than 10 cm thick)"@en ;
    skos:topConceptOf glosis_res:carbonatesFormsValueCode .

glosis_res:carbonatesFormsValueCode-M a glosis_res:CarbonatesFormsValueCode,
        skos:Concept ;
    skos:definition "Secondary carbonates in soil in the form of marl layer" ;
    skos:inScheme glosis_res:carbonatesFormsValueCode ;
    skos:notation "M" ;
    skos:prefLabel "marl layer"@en ;
    skos:topConceptOf glosis_res:carbonatesFormsValueCode .

glosis_res:carbonatesFormsValueCode-PM a glosis_res:CarbonatesFormsValueCode,
        skos:Concept ;
    skos:definition "Secondary carbonates in soil in the form of pseudomycelia i.e. carbonate infillings in pores, resembling mycelia" ;
    skos:inScheme glosis_res:carbonatesFormsValueCode ;
    skos:notation "PM" ;
    skos:prefLabel "pseudomycelia* (carbonate infillings in pores, resembling mycelia)"@en ;
    skos:topConceptOf glosis_res:carbonatesFormsValueCode .

glosis_res:carbonatesFormsValueCode-SC a glosis_res:CarbonatesFormsValueCode,
        skos:Concept ;
    skos:definition "Secondary carbonates in soil in the form of soft concretions" ;
    skos:inScheme glosis_res:carbonatesFormsValueCode ;
    skos:notation "SC" ;
    skos:prefLabel "soft concretions"@en ;
    skos:topConceptOf glosis_res:carbonatesFormsValueCode .

glosis_res:cementationContinuityValueCode-B a glosis_res:CementationContinuityValueCode,
        skos:Concept ;
    skos:definition "The layer is less than 50 percent cemented or compacted, and shows a rather irregular appearance." ;
    skos:inScheme glosis_res:cementationContinuityValueCode ;
    skos:notation "B" ;
    skos:prefLabel "Broken"@en ;
    skos:topConceptOf glosis_res:cementationContinuityValueCode .

glosis_res:cementationContinuityValueCode-C a glosis_res:CementationContinuityValueCode,
        skos:Concept ;
    skos:definition "The layer is more than 90 percent cemented or compacted, and is only interrupted in places by cracks or fissures." ;
    skos:inScheme glosis_res:cementationContinuityValueCode ;
    skos:notation "C" ;
    skos:prefLabel "Continuous"@en ;
    skos:topConceptOf glosis_res:cementationContinuityValueCode .

glosis_res:cementationContinuityValueCode-D a glosis_res:CementationContinuityValueCode,
        skos:Concept ;
    skos:definition "The layer is 50–90 percent cemented or compacted, and in general shows a regular appearance." ;
    skos:inScheme glosis_res:cementationContinuityValueCode ;
    skos:notation "D" ;
    skos:prefLabel "Discontinuous"@en ;
    skos:topConceptOf glosis_res:cementationContinuityValueCode .

glosis_res:cementationDegreeValueCode-C a glosis_res:CementationDegreeValueCode,
        skos:Concept ;
    skos:definition "Cemented mass cannot be broken in the hands and is continuous (more than 90 percent of soil mass)." ;
    skos:inScheme glosis_res:cementationDegreeValueCode ;
    skos:notation "C" ;
    skos:prefLabel "Cemented"@en ;
    skos:topConceptOf glosis_res:cementationDegreeValueCode .

glosis_res:cementationDegreeValueCode-I a glosis_res:CementationDegreeValueCode,
        skos:Concept ;
    skos:definition "Cemented mass cannot be broken by body weight (75-kg standard soil scientist) (more than 90 percent of soil mass)." ;
    skos:inScheme glosis_res:cementationDegreeValueCode ;
    skos:notation "I" ;
    skos:prefLabel "Indurated"@en ;
    skos:topConceptOf glosis_res:cementationDegreeValueCode .

glosis_res:cementationDegreeValueCode-M a glosis_res:CementationDegreeValueCode,
        skos:Concept ;
    skos:definition "Cemented mass cannot be broken in the hands but is discontinuous (less than 90 percent of soil mass)." ;
    skos:inScheme glosis_res:cementationDegreeValueCode ;
    skos:notation "M" ;
    skos:prefLabel "Moderately cemented"@en ;
    skos:topConceptOf glosis_res:cementationDegreeValueCode .

glosis_res:cementationDegreeValueCode-N a glosis_res:CementationDegreeValueCode,
        skos:Concept ;
    skos:definition "Neither cementation nor compaction observed (slakes in water)." ;
    skos:inScheme glosis_res:cementationDegreeValueCode ;
    skos:notation "N" ;
    skos:prefLabel "Non-cemented and non-compacted"@en ;
    skos:topConceptOf glosis_res:cementationDegreeValueCode .

glosis_res:cementationDegreeValueCode-W a glosis_res:CementationDegreeValueCode,
        skos:Concept ;
    skos:definition "Cemented mass is brittle and hard, but can be broken in the hands." ;
    skos:inScheme glosis_res:cementationDegreeValueCode ;
    skos:notation "W" ;
    skos:prefLabel "Weakly cemented"@en ;
    skos:topConceptOf glosis_res:cementationDegreeValueCode .

glosis_res:cementationDegreeValueCode-Y a glosis_res:CementationDegreeValueCode,
        skos:Concept ;
    skos:definition "Compacted mass is appreciably harder or more brittle than other comparable soil mass (slakes in water)." ;
    skos:inScheme glosis_res:cementationDegreeValueCode ;
    skos:notation "Y" ;
    skos:prefLabel "Compacted but non-cemented"@en ;
    skos:topConceptOf glosis_res:cementationDegreeValueCode .

glosis_res:cementationFabricValueCode-D a glosis_res:CementationFabricValueCode,
        skos:Concept ;
    skos:definition "The layer is largely constructed from cemented nodules or concretions of irregular shape." ;
    skos:inScheme glosis_res:cementationFabricValueCode ;
    skos:notation "D" ;
    skos:prefLabel "Nodular"@en ;
    skos:topConceptOf glosis_res:cementationFabricValueCode .

