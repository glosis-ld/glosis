###  http://w3id.org/glosis/model/codelists/results/ErosionCategoryValueCode
:ErosionCategoryValueCode rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( :erosionCategoryValueCode-A
                                                            :erosionCategoryValueCode-AD
                                                            :erosionCategoryValueCode-AM
                                                            :erosionCategoryValueCode-AS
                                                            :erosionCategoryValueCode-AZ
                                                            :erosionCategoryValueCode-M
                                                            :erosionCategoryValueCode-N
                                                            :erosionCategoryValueCode-NK
                                                            :erosionCategoryValueCode-W
