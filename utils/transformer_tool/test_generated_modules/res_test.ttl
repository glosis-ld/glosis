    skos:notation "1" ;
    skos:prefLabel "Between 0% and 5%"@en ;
    skos:topConceptOf glosis_res:erosionTotalAreaAffectedValueCode .

glosis_res:erosionTotalAreaAffectedValueCode-2 a glosis_res:ErosionTotalAreaAffectedValueCode,
        skos:Concept ;
    skos:definition "The total percentage of area affected by erosion is between 5 - 10" ;
    skos:inScheme glosis_res:erosionTotalAreaAffectedValueCode ;
    skos:notation "2" ;
    skos:prefLabel "Between 5% and 10%"@en ;
    skos:topConceptOf glosis_res:erosionTotalAreaAffectedValueCode .

glosis_res:erosionTotalAreaAffectedValueCode-3 a glosis_res:ErosionTotalAreaAffectedValueCode,
        skos:Concept ;
    skos:definition "The total percentage of area affected by erosion is between 10 to 25" ;
    skos:inScheme glosis_res:erosionTotalAreaAffectedValueCode ;
    skos:notation "3" ;
    skos:prefLabel "Between 10% and 25%"@en ;
    skos:topConceptOf glosis_res:erosionTotalAreaAffectedValueCode .

glosis_res:erosionTotalAreaAffectedValueCode-4 a glosis_res:ErosionTotalAreaAffectedValueCode,
        skos:Concept ;
    skos:definition "The total percentage of area affected by erosion is between 25 to 50" ;
    skos:inScheme glosis_res:erosionTotalAreaAffectedValueCode ;
    skos:notation "4" ;
    skos:prefLabel "Between 25% and 50%"@en ;
    skos:topConceptOf glosis_res:erosionTotalAreaAffectedValueCode .

glosis_res:erosionTotalAreaAffectedValueCode-5 a glosis_res:ErosionTotalAreaAffectedValueCode,
        skos:Concept ;
    skos:definition "The total percentage of area affected by erosion is more than 50: >50%" ;
    skos:inScheme glosis_res:erosionTotalAreaAffectedValueCode ;
    skos:notation "5" ;
    skos:prefLabel "More than 50%"@en ;
    skos:topConceptOf glosis_res:erosionTotalAreaAffectedValueCode .

