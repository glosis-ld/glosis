    <!-- http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD1 -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD1">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCollection"/>
        <skos:definition>materials with vesicular pores, mineral soils with andic properties. Sample disintegrates at the instant of sampling, many pores visible onthe pit wall. Sample disintegrates at the instant of sampling, many pores visible on the pit wall. Loamy soils with high clay content, clayey soils When dropped, sample disintegrates into numerous fragments, further disintegration of subfragments after application of weak pressure.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>BD1</skos:notation>
        <skos:prefLabel xml:lang="en">Many pores, moist materials drop easily out of the auger.</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD2 -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD2">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCollection"/>
        <skos:definition>Loamy soils with high clay content, clayey soils. When dropped, sample disintegrates into few fragments, further disintegration of subfragments after application of mild pressure.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>BD2</skos:notation>
        <skos:prefLabel xml:lang="en">Sample disintegrates into numerous fragments after application of weak pressure.</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD3 -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD3">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCollection"/>
        <skos:definition>Loamy soils with high clay content, clayey soils. Sample remains mostly intact when dropped, further disintegration possible after application of large pressure.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>BD3</skos:notation>
        <skos:prefLabel xml:lang="en">Knife can be pushed into the moist soil with weak pressure, sample disintegrates into few fragments, which may be further divided.</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD4 -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD4">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCollection"/>
        <skos:definition>Loamy soils with high clay content, clayey soils. Sample remains intact when dropped, no further disintegration after application of very large pressure.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>BD4</skos:notation>
        <skos:prefLabel xml:lang="en">Knife penetrates only 1–2 cm into the moist soil, some effort required, sample disintegrates into few fragments, which cannot be subdivided further.</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD5 -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD5">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCollection"/>
        <skos:definition>Loamy soils with high clay content, clayey soils. Sample remains intact when dropped, no further disintegration after application of very large pressure.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>BD5</skos:notation>
        <skos:prefLabel xml:lang="en">Very large pressure necessary to force knife into the soil, no further disintegration of sample.</skos:prefLabel>
