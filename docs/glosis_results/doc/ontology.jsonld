    "@value" : "Non-sticky"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/stickinessValueCode-SSS",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StickinessValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StickinessValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Additional code of combination of SST and ST"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "SSS"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "slightly sticky to sticky"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/stickinessValueCode-SST",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StickinessValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StickinessValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "After pressure, soil material adheres to both thumb and finger but comes off one or the other rather cleanly. It is not appreciably stretched when the digits are separated."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "SST"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Slightly sticky"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/stickinessValueCode-ST",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StickinessValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StickinessValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "After pressure, soil material adheres to both thumb and finger and tends to stretch somewhat and pull apart rather than pulling free from either digit."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "ST"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Sticky"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/stickinessValueCode-SVS",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StickinessValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StickinessValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Additional code of combination of ST and VST"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "SVS"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "sticky to very sticky"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/stickinessValueCode-VST",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StickinessValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StickinessValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "After pressure, soil material adheres strongly to both thumb and finger and is decidedly stretched when they are separated."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "VST"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Very sticky"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/structureGradeValueCode-MO",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StructureGradeValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StructureGradeValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Aggregates are observable in place and there is a distinct arrangement of natural surfaces of weakness. When disturbed, the soil material breaks into a mixture of many entire aggregates, some broken aggregates, and little material without aggregates faces. Aggregates surfaces generally show distinct differences with the aggregates interiors."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "MO"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Moderate"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/structureGradeValueCode-MS",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StructureGradeValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/StructureGradeValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Moderate to strong"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
