    </owl:NamedIndividual>
    


    <!-- http://w3id.org/glosis/model/codelists/results/mineralConcKindValueCode-T -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/mineralConcKindValueCode-T">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/MineralConcKindValueCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:isPartOf rdf:resource="http://w3id.org/glosis/model/codelists/results/MineralConcKindValueCollection"/>
        <skos:definition>Crystals in soil refer to solid, naturally occurring minerals that have a regular and repeating internal structure, which can often be seen under a microscope or with the naked eye. These crystal formations typically occur when minerals precipitate from water or melt and re-crystallize under certain environmental conditions, such as changes in temperature or pressure. Common crystal minerals in soil include quartz, gypsum, calcite, and halite. The presence of crystals in soil can significantly affect its properties, including drainage, fertility, and nutrient availability. For example, gypsum crystals can improve soil structure, while the presence of salt crystals can lead to soil salinity problems. Source: Brady &amp; Weil (2017), The Nature and Properties of Soils.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>T</skos:notation>
        <skos:prefLabel xml:lang="en">Crystal</skos:prefLabel>
    </owl:NamedIndividual>
    


