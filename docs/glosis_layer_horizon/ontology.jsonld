  }, {
    "@id" : "_:genid791"
  }, {
    "@id" : "_:genid792"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/ZincExtractableElements",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Extractable zinc refers to the fraction of zinc that is bioavailable to plants and is measured using specific chemical extraction methods. Zinc is an essential micronutrient for plant growth. Source: Sparks, D.L. (2003). Environmental Soil Chemistry."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ZincExtractableElements"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/glosis/model/layerhorizon/PhysioChemical"
  }, {
    "@id" : "_:genid793"
  }, {
    "@id" : "_:genid794"
  }, {
    "@id" : "_:genid795"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/ZincExtractableElementsValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
