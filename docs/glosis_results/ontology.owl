        <rdfs:label xml:lang="en">Code list for FragmentCoverValue - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/FragmentCoverValueCollection"/>
        <skos:definition>Coarse surface fragments, including those partially exposed, should be described in terms of percentage of surface coverage and of size of the fragments. See more in Guidelines for Soil Description issued by the FAO: table 15,1</skos:definition>
    </owl:Class>
    


