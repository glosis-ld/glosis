  }, {
    "@id" : "_:genid131"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 24,2"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/BulkDensityFineEarth",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Bulk density of fine earth is the mass of dry soil divided by the volume it occupies, excluding coarse fragments (particles >2 mm). It influences root growth, water movement, and porosity. Source: Hillel, D. (2004). Soil Physics."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "BulkDensityFineEarth"
