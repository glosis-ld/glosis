  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Peat drainage describes the extent of water movement or drainage within peat soils. Poor drainage leads to anaerobic conditions and slow decomposition. Source: Soil Survey Manual (USDA, 2017)."
  } ],
