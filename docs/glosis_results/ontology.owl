                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/fragmentCoverValueCode-N"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/results/fragmentCoverValueCode-V"/>
                </owl:oneOf>
