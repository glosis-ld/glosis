    <!-- http://w3id.org/glosis/model/codelists/results/coatingContrastValueCode-D -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/coatingContrastValueCode-D">
        <rdf:type rdf:resource="http://w3id.org/glosis/model/codelists/results/CoatingContrastValueCode"/>
