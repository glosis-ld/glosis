###  http://w3id.org/glosis/model/codelists/properties/ClayPropertyCode
:ClayPropertyCode rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( :clayPropertyCode-CC
                                                    :clayPropertyCode-CNC
                                                    :clayPropertyCode-CWT
                                                  )
                                      ] ;
                  rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ,
                                  <http://www.w3.org/ns/sosa/ObservableProperty> ;
                  rdfs:comment "This code list class provides the ClayProperty codes."@en ;
                  rdfs:label "Code list class for ClayProperty - codelist class"@en ;
                  rdfs:seeAlso :ClayPropertyCollection ;
                  <http://www.w3.org/2004/02/skos/core#definition> "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3" .


