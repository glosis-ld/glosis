###  http://w3id.org/glosis/model/codelists/results/ConsistenceDryValueCode
:ConsistenceDryValueCode rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( :consistenceDryValueCode-EHA
                                                           :consistenceDryValueCode-HA
