        glosis_res:gypsumContentValueCode-ST ;
    skos:note "This code list provides the GypsumContentValue codes."@en ;
    skos:prefLabel "Code list for GypsumContentValue - codelist class"@en .

glosis_res:GypsumFormsValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:GypsumFormsValueCode ;
    skos:definition "The forms of secondary gypsum in soils are diverse and are considered to be informative for diagnostics of soil genesis. See more information in the Guidelines for Soil Description issued by the FAO: table 41" ;
