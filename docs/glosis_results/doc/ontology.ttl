###  http://w3id.org/glosis/model/codelists/results/stickinessValueCode-NST
:stickinessValueCode-NST rdf:type owl:NamedIndividual ,
                                  :StickinessValueCode ,
                                  <http://www.w3.org/2004/02/skos/core#Concept> ;
                         <http://purl.org/dc/terms/isPartOf> :StickinessValueCollection ;
                         <http://www.w3.org/2004/02/skos/core#definition> "After release of pressure, practically no soil material adheres to thumb and finger." ;
                         <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                         <http://www.w3.org/2004/02/skos/core#notation> "NST" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Non-sticky"@en .


###  http://w3id.org/glosis/model/codelists/results/stickinessValueCode-SSS
:stickinessValueCode-SSS rdf:type owl:NamedIndividual ,
                                  :StickinessValueCode ,
                                  <http://www.w3.org/2004/02/skos/core#Concept> ;
                         <http://purl.org/dc/terms/isPartOf> :StickinessValueCollection ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Additional code of combination of SST and ST" ;
                         <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                         <http://www.w3.org/2004/02/skos/core#notation> "SSS" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "slightly sticky to sticky"@en .


###  http://w3id.org/glosis/model/codelists/results/stickinessValueCode-SST
:stickinessValueCode-SST rdf:type owl:NamedIndividual ,
                                  :StickinessValueCode ,
                                  <http://www.w3.org/2004/02/skos/core#Concept> ;
                         <http://purl.org/dc/terms/isPartOf> :StickinessValueCollection ;
                         <http://www.w3.org/2004/02/skos/core#definition> "After pressure, soil material adheres to both thumb and finger but comes off one or the other rather cleanly. It is not appreciably stretched when the digits are separated." ;
                         <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                         <http://www.w3.org/2004/02/skos/core#notation> "SST" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Slightly sticky"@en .


###  http://w3id.org/glosis/model/codelists/results/stickinessValueCode-ST
:stickinessValueCode-ST rdf:type owl:NamedIndividual ,
                                 :StickinessValueCode ,
                                 <http://www.w3.org/2004/02/skos/core#Concept> ;
                        <http://purl.org/dc/terms/isPartOf> :StickinessValueCollection ;
                        <http://www.w3.org/2004/02/skos/core#definition> "After pressure, soil material adheres to both thumb and finger and tends to stretch somewhat and pull apart rather than pulling free from either digit." ;
                        <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                        <http://www.w3.org/2004/02/skos/core#notation> "ST" ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Sticky"@en .


###  http://w3id.org/glosis/model/codelists/results/stickinessValueCode-SVS
:stickinessValueCode-SVS rdf:type owl:NamedIndividual ,
                                  :StickinessValueCode ,
                                  <http://www.w3.org/2004/02/skos/core#Concept> ;
                         <http://purl.org/dc/terms/isPartOf> :StickinessValueCollection ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Additional code of combination of ST and VST" ;
                         <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                         <http://www.w3.org/2004/02/skos/core#notation> "SVS" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "sticky to very sticky"@en .


###  http://w3id.org/glosis/model/codelists/results/stickinessValueCode-VST
:stickinessValueCode-VST rdf:type owl:NamedIndividual ,
                                  :StickinessValueCode ,
                                  <http://www.w3.org/2004/02/skos/core#Concept> ;
                         <http://purl.org/dc/terms/isPartOf> :StickinessValueCollection ;
                         <http://www.w3.org/2004/02/skos/core#definition> "After pressure, soil material adheres strongly to both thumb and finger and is decidedly stretched when they are separated." ;
                         <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                         <http://www.w3.org/2004/02/skos/core#notation> "VST" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Very sticky"@en .


###  http://w3id.org/glosis/model/codelists/results/structureGradeValueCode-MO
:structureGradeValueCode-MO rdf:type owl:NamedIndividual ,
                                     :StructureGradeValueCode ,
                                     <http://www.w3.org/2004/02/skos/core#Concept> ;
                            <http://purl.org/dc/terms/isPartOf> :StructureGradeValueCollection ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Aggregates are observable in place and there is a distinct arrangement of natural surfaces of weakness. When disturbed, the soil material breaks into a mixture of many entire aggregates, some broken aggregates, and little material without aggregates faces. Aggregates surfaces generally show distinct differences with the aggregates interiors." ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                            <http://www.w3.org/2004/02/skos/core#notation> "MO" ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Moderate"@en .


###  http://w3id.org/glosis/model/codelists/results/structureGradeValueCode-MS
:structureGradeValueCode-MS rdf:type owl:NamedIndividual ,
                                     :StructureGradeValueCode ,
                                     <http://www.w3.org/2004/02/skos/core#Concept> ;
                            <http://purl.org/dc/terms/isPartOf> :StructureGradeValueCollection ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Moderate to strong" ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                            <http://www.w3.org/2004/02/skos/core#notation> "MS" ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Moderate to strong"@en .


###  http://w3id.org/glosis/model/codelists/results/structureGradeValueCode-ST
:structureGradeValueCode-ST rdf:type owl:NamedIndividual ,
                                     :StructureGradeValueCode ,
                                     <http://www.w3.org/2004/02/skos/core#Concept> ;
                            <http://purl.org/dc/terms/isPartOf> :StructureGradeValueCollection ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Aggregates are clearly observable in place and there is a prominent arrangement of natural surfaces of weakness. When disturbed, the soil material separates mainly into entire aggregates. Aggregates surfaces generally differ markedly from aggregate interiors." ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                            <http://www.w3.org/2004/02/skos/core#notation> "ST" ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Strong"@en .


###  http://w3id.org/glosis/model/codelists/results/structureGradeValueCode-WE
:structureGradeValueCode-WE rdf:type owl:NamedIndividual ,
                                     :StructureGradeValueCode ,
                                     <http://www.w3.org/2004/02/skos/core#Concept> ;
                            <http://purl.org/dc/terms/isPartOf> :StructureGradeValueCollection ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Aggregates are barely observable in place and there is only a weak arrangement of natural surfaces of weakness. When gently disturbed, the soil material breaks into a mixture of few entire aggregates, many broken aggregates, and much material without aggregate faces. Aggregate surfaces differ in some way from the aggregate interior." ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                            <http://www.w3.org/2004/02/skos/core#notation> "WE" ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Weak"@en .


###  http://w3id.org/glosis/model/codelists/results/structureGradeValueCode-WM
:structureGradeValueCode-WM rdf:type owl:NamedIndividual ,
                                     :StructureGradeValueCode ,
                                     <http://www.w3.org/2004/02/skos/core#Concept> ;
                            <http://purl.org/dc/terms/isPartOf> :StructureGradeValueCollection ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Weak to moderate" ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                            <http://www.w3.org/2004/02/skos/core#notation> "WM" ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Weak to moderate"@en .


###  http://w3id.org/glosis/model/codelists/results/structureSizeValueCode-CO
