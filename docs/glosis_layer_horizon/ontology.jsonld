  }, {
    "@id" : "_:genid654"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/SaltContent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Salt content quantifies the total soluble salts in the soil, often expressed as electrical conductivity (EC) of a soil extract. It is crucial for assessing salinity risk. Source: FAO (2006). Guidelines for Soil Description."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "SaltContent"
  } ],
