PREFIX owl:   <http://www.w3.org/2002/07/owl#>
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX ssn:   <http://www.w3.org/ns/ssn/>
PREFIX glosis_res: <http://w3id.org/glosis/model/codelists/results/>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbprop: <http://dbpedia.org/property/>
PREFIX dct: <http://purl.org/dc/terms/>


CONSTRUCT {
### concept scheme
  glosis_res: a skos:ConceptScheme ;
    skos:prefLabel ?cs_label ;
    rdfs:label ?cs_label ;
    skos:note ?cs_note ;
    .

### skos collection
  ?URI3 a skos:Collection ;
    skos:prefLabel ?col_label ;
    skos:note ?col_comment ;
    skos:definition ?cs_definition ;
    rdfs:seeAlso ?URI2 ;
    skos:member ?c_oneof ;
   .
    
### concept class
  ?URI2 a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label ?c_label ;
    rdfs:comment ?c_comment ;
    skos:definition ?cs_definition ;
    rdfs:seeAlso ?URI3 ;
    # the query omitts a collection connected to owl:oneOf on purpose, this will be
    # properly added in postprocessing phase due to the limitations of TARQL! 
   .  

### concepts
  ?c_oneof a skos:Concept; a ?URI2 ; a ?compoundURI ; a ?substanceURI ;
    skos:prefLabel ?i_label ;
    skos:notation  ?i_notation ;
    skos:definition ?i_description ;
    skos:scopeNote ?i_reference ;
    skos:scopeNote ?i_citation ;
    skos:inScheme ?URI1 ;
    skos:broader ?broaderURI ;
    dct:isPartOf ?URI3 ;
    skos:exactMatch ?i_exactMatch ;
    skos:closeMatch ?i_closeMatch ;
    # Chemical substances
    dbo:pubchem ?pub_chem_code ;
    dbo:inchi ?inchi_code ;
    dbprop:inchikey ?inchi_key_code ;
    rdfs:seeAlso ?pub_chem_URI ;
    .

  ?broaderURI skos:narrower ?c_oneof .
}
WHERE {
  BIND (URI('http://w3id.org/glosis/model/codelists/results/') AS ?URI1)
  BIND (STRLANG(CONCAT('Code list for ', 'Glosis results', ' - codelist scheme'),"en") AS ?cs_label)
  BIND (STRLANG(CONCAT('This code list provides possible values for ', 'glosis results.'), "en") AS ?cs_note)
  BIND (IF(?collection_definition != '', ?collection_definition, ?nothing) AS ?cs_definition)
  BIND (CONCAT(UCASE(SUBSTR(?collection, 1, 1)), SUBSTR(?collection, 2)) AS ?collection_capitalize)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/codelists/results/', ?collection_capitalize, 'Value', 'Code')) AS ?URI2)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/codelists/results/', ?collection_capitalize, 'Value', 'Collection')) AS ?URI3)
  BIND (STRLANG(CONCAT('Code list for ', ?collection_capitalize, 'Value', ' - codelist class'),"en")  AS ?c_label)
  BIND (STRLANG(CONCAT('This code list class provides the ', ?collection_capitalize, 'Value', ' codes.'), "en") AS ?c_comment)
  BIND (STRLANG(CONCAT('Code list for ', ?collection_capitalize, 'Value', ' - codelist collection'),"en")  AS ?col_label)
  BIND (STRLANG(CONCAT('This code list collection provides the ', ?collection_capitalize, 'Value', ' codes.'), "en") AS ?col_comment)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/codelists/results/', ?collection, 'Value', 'Code', '-', ?concept)) AS ?oneof)
  BIND (IF(?concept != '', ?oneof, ?nothing) AS ?c_oneof)
  BIND (STRLANG(?label, "en")  AS ?i_label)
  BIND (IF(?notation != '', ?notation, ?nothing) AS ?i_notation)
  BIND (IF(?definition != '', ?definition, ?nothing) AS ?i_description)
  BIND (IF(?reference != '', URI(?reference), ?nothing)  AS ?i_reference)
  BIND (IF(?citation != '', ?citation, ?nothing) AS ?i_citation)
  BIND (IF(?parent_concept = '', ?URI1, ?nothing) AS ?top_URI)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/codelists/results/', ?collection, 'Value', 'Code', '-', ?parent_concept)) AS ?parentURI)
  BIND (IF(?exact_match != '', ?exact_match, ?nothing) AS ?i_exactMatch)
  BIND (IF(?close_match != '', ?close_match, ?nothing) AS ?i_closeMatch)
  BIND (IF(?parent_concept != '', ?parentURI, ?nothing) AS ?broaderURI)
  BIND (IF(?pub_chem != '', ?pub_chem, ?nothing) AS ?pub_chem_code)
  BIND (IF(?pub_chem != '', URI(CONCAT('https://pubchem.ncbi.nlm.nih.gov/compound/', ?pub_chem)), ?nothing) AS ?pub_chem_URI)
  BIND (IF(?pub_chem != '', dbo:ChemicalSubstance, ?nothing) AS ?substanceURI)
  BIND (IF(?inchi_key != '', ?inchi_key, ?nothing) AS ?inchi_key_code)
  BIND (IF(?inchi != '', ?inchi, ?nothing) AS ?inchi_code)
  BIND (IF(?pub_chem != '', dbo:ChemicalCompound, ?nothing) AS ?compoundURI)
}
