  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/mineralConcKindValueCode-IC",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/MineralConcKindValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/MineralConcKindValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Crack infillings refer to the materials that accumulate within cracks or fissures in the soil, typically formed due to drying or other physical stresses on the soil structure. These materials can include clays, silt, sand, or mineral deposits that enter cracks over time, often through the action of water or wind. Crack infillings can influence the soil's physical properties, such as its permeability and structure, as they may either facilitate or impede the movement of water and air through the soil. Additionally, crack infillings can impact soil fertility, as they may contain higher concentrations of certain nutrients or minerals that accumulate in these voids. Source: Soil Science Society of America."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "IC"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Crack infillings"
  } ]
}, {
