}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/PoresSize",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Pore size refers to the dimensions of void spaces within the soil matrix. It affects water infiltration, retention, and air movement. Pores are classified as macropores, mesopores, and micropores based on size. Source: Hillel, D. (2004). Introduction to Environmental Soil Physics."
  } ],
