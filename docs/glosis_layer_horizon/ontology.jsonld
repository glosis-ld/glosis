  }, {
    "@id" : "_:genid294"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 66"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/ConsistenceDry",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Dry consistence describes the resistance of dry soil to crushing or deformation. Categories include loose, soft, hard, and extremely hard. It provides information on soil strength when dry. Source: Soil Survey Manual (USDA, 2017)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ConsistenceDry"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "_:genid295"
  }, {
    "@id" : "_:genid296"
  }, {
    "@id" : "_:genid300"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 53"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/ConsistenceMoist",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Moist consistence describes the resistance of moist soil to deformation or rupture. It ranges from loose to firm, reflecting the soil’s cohesiveness under field moisture conditions. Source: Soil Survey Manual (USDA, 2017)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ConsistenceMoist"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "_:genid301"
  }, {
    "@id" : "_:genid302"
  }, {
    "@id" : "_:genid306"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 54"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/CopperExtractableElements",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Extractable copper refers to the portion of total copper in the soil that is available for plant uptake, measured using chemical extractants. It is an essential micronutrient but can be toxic at high concentrations. Source: Adriano, D.C. (2001). Trace Elements in Terrestrial Environments."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CopperExtractableElements"
  } ],
