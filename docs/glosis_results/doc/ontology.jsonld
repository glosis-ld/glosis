}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-B",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Discontinuous spherical or elliptical voids (chambers) of sedimentary origin or formed by compressed air, e.g. gas bubbles in slaking crusts after heavy rainfall. Relatively unimportant in connection with plant growth."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "B"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Vesicular"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-C",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Elongated voids of faunal or floral origin, mostly tubular in shape and continuous, varying strongly in diameter. When wider than a few centimetres (burrow holes), they are more adequately described under biological activity."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "C"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Channels"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-I",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Controlled by the fabric, or arrangement, of the soil particles, also known as textural voids. Subdivision possible into simple packing voids, which relate to the packing of sand particles, and compound packing voids, which result from the packing of non-accommodating peds. Predominantly irregular in shape and interconnected, and hard to quantify in the field."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "I"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Interstitial"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-P",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Most planes are extra-pedal voids, related to accommodating ped surfaces or cracking patterns. They are often not persistent and vary in size, shape and quantity depending on the moisture condition of the soil. Planar voids may be recorded, describing width and frequency."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "P"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Planes"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/voidsClassificationValueCode-V",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/VoidsClassificationValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Mostly irregular, equidimensional voids of faunal origin or resulting from tillage or disturbance of other voids. Discontinuous or interconnected. May be quantified in specific cases."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "V"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Vughs"
  } ]
