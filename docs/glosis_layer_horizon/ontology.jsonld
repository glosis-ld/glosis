  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Exchangeable potassium refers to the form of potassium held on soil colloid surfaces and available for plant uptake. It is measured using ammonium acetate extraction. Source: Sparks, D.L. (2003). Environmental Soil Chemistry."
  } ],
