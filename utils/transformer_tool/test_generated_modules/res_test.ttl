    skos:inScheme glosis_res:bleachedSandValueCode ;
    skos:notation "Low" ;
    skos:prefLabel "Bleached sand of surface coverage 2-15%"@en ;
    skos:topConceptOf glosis_res:bleachedSandValueCode .

