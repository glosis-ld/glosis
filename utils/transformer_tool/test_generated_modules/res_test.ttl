        skos:Concept ;
    skos:definition "Crop code for Vegetables class" ;
    skos:inScheme glosis_res:cropClassValueCode ;
    skos:notation "Ve" ;
    skos:prefLabel "Vegetables"@en ;
    skos:topConceptOf glosis_res:cropClassValueCode .

