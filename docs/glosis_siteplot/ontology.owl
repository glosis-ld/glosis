<?xml version="1.0"?>
<rdf:RDF xmlns="http://w3id.org/glosis/model/siteplot#"
     xml:base="http://w3id.org/glosis/model/siteplot"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="http://schema.org/"
     xmlns:schema1="https://schema.org/"
     xmlns:ontology="http://dbpedia.org/ontology/"
     xmlns:property="http://dbpedia.org/property/">
    <owl:Ontology rdf:about="http://w3id.org/glosis/model/siteplot">
        <owl:versionIRI rdf:resource="http://w3id.org/glosis/model/siteplot/2.0.0"/>
        <owl:imports rdf:resource="http://w3id.org/glosis/model/codelists/properties/"/>
        <owl:imports rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <owl:imports rdf:resource="http://w3id.org/glosis/model/common/"/>
        <owl:imports rdf:resource="http://w3id.org/glosis/model/iso28258/2013/"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/ssn/"/>
        <terms:creator rdf:resource="_:genid-nodeid-node1juk5lc1mx1957"/>
        <terms:creator rdf:nodeID="genid1"/>
        <terms:creator rdf:nodeID="genid3"/>
        <terms:description xml:lang="en">GLOSIS ontology has been created from the data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt</terms:description>
        <terms:rights xml:lang="en">This ontology is distributed under Creative Commons Attribution-NonCommercial-ShareAlike 3.0 IGO License - https://creativecommons.org/licenses/by-nc-sa/3.0/igo/</terms:rights>
        <terms:source xml:lang="en">Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt</terms:source>
        <terms:title xml:lang="en">GlOSIS Ontology: Site-Plot module</terms:title>
        <rdfs:comment xml:lang="en">This module contains the classes and properties to describe soil sites (a defined area which is subject to a soil quality investigation) and soil plots (an elementary area where individual observations are made and/or samples are taken).</rdfs:comment>
        <owl:versionInfo>2.0.0</owl:versionInfo>
    </owl:Ontology>
    <rdf:Description rdf:nodeID="genid1">
        <schema:affiliation>
            <rdf:Description>
                <foaf:name>PSNC</foaf:name>
            </rdf:Description>
        </schema:affiliation>
        <rdfs:seeAlso rdf:resource="http://orcid.org/0000-0003-4289-4922"/>
        <foaf:name>Raul Palma</foaf:name>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid3">
        <schema:affiliation>
            <rdf:Description>
                <foaf:name>PSNC</foaf:name>
            </rdf:Description>
        </schema:affiliation>
        <foaf:name>Bogusz Janiak</foaf:name>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/glosis/model/siteplot/altitude -->


    <owl:ObjectProperty rdf:about="http://w3id.org/glosis/model/siteplot/altitude">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment>Refers to the vertical distance above or below a reference point, typically sea level, at which a soil sample or observation is located.</rdfs:comment>
        <rdfs:label xml:lang="en">altitude</rdfs:label>
        <skos:definition xml:lang="en">Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/country -->


    <owl:ObjectProperty rdf:about="http://w3id.org/glosis/model/siteplot/country">
        <rdfs:range rdf:resource="https://www.omg.org/spec/LCC/Countries/CountryRepresentation/Alpha2Code"/>
        <rdfs:comment>Refers to the national jurisdiction or geopolitical region in which the soil sample or observation was taken, indicating the broader context of the location</rdfs:comment>
        <rdfs:label xml:lang="en">country</rdfs:label>
        <skos:definition xml:lang="en">Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/positionalAccuracy -->


    <owl:ObjectProperty rdf:about="http://w3id.org/glosis/model/siteplot/positionalAccuracy">
        <rdfs:range rdf:resource="http://www.w3.org/ns/ssn/Property"/>
        <rdfs:comment>Refers to the degree to which the geographic location of a soil sample or observation corresponds to its true location, often expressed as a range or error margin.</rdfs:comment>
        <rdfs:label xml:lang="en">positionalAccuracy</rdfs:label>
        <skos:definition xml:lang="en">Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/responsibleOrganization -->


    <owl:ObjectProperty rdf:about="http://w3id.org/glosis/model/siteplot/responsibleOrganization">
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:comment>Refers to the entity or organization accountable for collecting, managing, or providing soil data or related information.</rdfs:comment>
        <rdfs:label xml:lang="en">responsibleOrganization</rdfs:label>
        <skos:definition xml:lang="en">Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/timestamp -->


    <owl:ObjectProperty rdf:about="http://w3id.org/glosis/model/siteplot/timestamp"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/glosis/model/siteplot/cropDescription -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/glosis/model/siteplot/cropDescription">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Description of crops at the site</rdfs:comment>
        <skos:definition xml:lang="en">ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/landUseCropRotation -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/glosis/model/siteplot/landUseCropRotation">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Description of crop rotation at the site</rdfs:comment>
        <rdfs:label xml:lang="en">landUseCropRotation</rdfs:label>
        <skos:definition xml:lang="en">ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/landUseRemark -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/glosis/model/siteplot/landUseRemark">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Description of land use at the site</rdfs:comment>
        <rdfs:label xml:lang="en">landUseRemark</rdfs:label>
        <skos:definition xml:lang="en">ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/location -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/glosis/model/siteplot/location">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Refers to the geographic location or descriptive details that pinpoint where a soil sample or observation is made.</rdfs:comment>
        <rdfs:label xml:lang="en">location</rdfs:label>
        <skos:definition xml:lang="en">Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/mapSheetID -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/glosis/model/siteplot/mapSheetID">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Refers to the unique identifier assigned to a specific map sheet or map section, which is used for referencing detailed geographic or soil data in mapping systems.</rdfs:comment>
        <rdfs:label xml:lang="en">mapSheetID</rdfs:label>
        <skos:definition xml:lang="en">Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/parentRemarks -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/glosis/model/siteplot/parentRemarks">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Remarks on the parent material</rdfs:comment>
        <rdfs:label xml:lang="en">parentRemarks</rdfs:label>
        <skos:definition xml:lang="en">ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/physiographyDescription -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/glosis/model/siteplot/physiographyDescription">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Description of the local physiography</rdfs:comment>
        <rdfs:label xml:lang="en">physiographyDescription</rdfs:label>
        <skos:definition xml:lang="en">ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/remarks -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/glosis/model/siteplot/remarks">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Refer to additional comments or annotations about a soil sample, observation, or dataset, often providing context or explanations for the data.</rdfs:comment>
        <rdfs:label xml:lang="en">remarks</rdfs:label>
        <skos:definition xml:lang="en">Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/timestamp -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/glosis/model/siteplot/timestamp">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/glosis/model/siteplot/vegetationDescription -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/glosis/model/siteplot/vegetationDescription">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Description of vegetation at the site</rdfs:comment>
        <rdfs:label xml:lang="en">vegetationDescription</rdfs:label>
        <skos:definition xml:lang="en">ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 1</skos:definition>
    </owl:DatatypeProperty>
    


