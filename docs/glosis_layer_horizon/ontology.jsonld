  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/Sand",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Sand is the coarsest soil particle, ranging in size from 0.05 to 2.0 mm. Sandy soils have high permeability but low water and nutrient retention. Source: Soil Science Society of America (SSSA) Glossary."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
