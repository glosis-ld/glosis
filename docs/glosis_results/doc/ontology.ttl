###  http://w3id.org/glosis/model/codelists/results/profileDescriptionStatusValueCode-1
:profileDescriptionStatusValueCode-1 rdf:type owl:NamedIndividual ,
                                              :ProfileDescriptionStatusValueCode ,
                                              <http://www.w3.org/2004/02/skos/core#Concept> ;
                                     <http://purl.org/dc/terms/isPartOf> :ProfileDescriptionStatusValueCollection ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "No essential elements or details are missing from the description, sampling or analysis. The accuracy and reliability of the description and analytical results permit the full characterization of all soil horizons to a depth of 125 cm, or more if required for classification, or down to a C or R horizon or layer, which may be shallower." ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                                     <http://www.w3.org/2004/02/skos/core#narrower> :profileDescriptionStatusValueCode-1.1 ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "1" ;
                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Reference profile description"@en .


###  http://w3id.org/glosis/model/codelists/results/profileDescriptionStatusValueCode-1.1
:profileDescriptionStatusValueCode-1.1 rdf:type owl:NamedIndividual ,
                                                :ProfileDescriptionStatusValueCode ,
                                                <http://www.w3.org/2004/02/skos/core#Concept> ;
                                       <http://purl.org/dc/terms/isPartOf> :ProfileDescriptionStatusValueCollection ;
                                       <http://www.w3.org/2004/02/skos/core#broader> :profileDescriptionStatusValueCode-1 ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "If soil description is done without sampling." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "1.1" ;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Reference profile description - no sampling"@en .


###  http://w3id.org/glosis/model/codelists/results/profileDescriptionStatusValueCode-2
:profileDescriptionStatusValueCode-2 rdf:type owl:NamedIndividual ,
                                              :ProfileDescriptionStatusValueCode ,
                                              <http://www.w3.org/2004/02/skos/core#Concept> ;
                                     <http://purl.org/dc/terms/isPartOf> :ProfileDescriptionStatusValueCollection ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "No essential elements are missing from the description, sampling or analysis. The number of samples collected is sufficient to characterize all major soil horizons, but may not allow precise definition of all subhorizons, especially in the deeper soil. The profile depth is 80 cm or more, or down to a C or R horizon or layer, which may be shallower. Additional augering and sampling may be required for lower level classification." ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                                     <http://www.w3.org/2004/02/skos/core#narrower> :profileDescriptionStatusValueCode-2.1 ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "2" ;
                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Routine profile description"@en .


###  http://w3id.org/glosis/model/codelists/results/profileDescriptionStatusValueCode-2.1
:profileDescriptionStatusValueCode-2.1 rdf:type owl:NamedIndividual ,
                                                :ProfileDescriptionStatusValueCode ,
                                                <http://www.w3.org/2004/02/skos/core#Concept> ;
                                       <http://purl.org/dc/terms/isPartOf> :ProfileDescriptionStatusValueCollection ;
                                       <http://www.w3.org/2004/02/skos/core#broader> :profileDescriptionStatusValueCode-2 ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "If soil description is done without sampling." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "2.1" ;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Routine profile description - no sampling"@en .


###  http://w3id.org/glosis/model/codelists/results/profileDescriptionStatusValueCode-3
:profileDescriptionStatusValueCode-3 rdf:type owl:NamedIndividual ,
                                              :ProfileDescriptionStatusValueCode ,
                                              <http://www.w3.org/2004/02/skos/core#Concept> ;
                                     <http://purl.org/dc/terms/isPartOf> :ProfileDescriptionStatusValueCollection ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Certain relevant elements are missing from the description, an insufficient number of samples was collected, or the reliability of the analytical data does not permit a complete characterization of the soil. However, the description is useful for specific purposes and provides a satisfactory indication of the nature of the soil at high levels of soil taxonomic classification." ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                                     <http://www.w3.org/2004/02/skos/core#narrower> :profileDescriptionStatusValueCode-3.1 ;
                                     <http://www.w3.org/2004/02/skos/core#notation> "3" ;
                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Incomplete description"@en .


###  http://w3id.org/glosis/model/codelists/results/profileDescriptionStatusValueCode-3.1
:profileDescriptionStatusValueCode-3.1 rdf:type owl:NamedIndividual ,
                                                :ProfileDescriptionStatusValueCode ,
                                                <http://www.w3.org/2004/02/skos/core#Concept> ;
                                       <http://purl.org/dc/terms/isPartOf> :ProfileDescriptionStatusValueCollection ;
                                       <http://www.w3.org/2004/02/skos/core#broader> :profileDescriptionStatusValueCode-3 ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "If soil description is done without sampling." ;
                                       <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                                       <http://www.w3.org/2004/02/skos/core#notation> "3.1" ;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Incomplete description - no sampling"@en .


###  http://w3id.org/glosis/model/codelists/results/profileDescriptionStatusValueCode-4
:profileDescriptionStatusValueCode-4 rdf:type owl:NamedIndividual ,
                                              :ProfileDescriptionStatusValueCode ,
                                              <http://www.w3.org/2004/02/skos/core#Concept> ;
                                     <http://purl.org/dc/terms/isPartOf> :ProfileDescriptionStatusValueCollection ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Soil augerings do no permit a comprehensive soil profile description. Augerings are made for routine soil observation and identification in soil mapping, and for that purpose normally provide a satisfactory indication of the soil characteristics. Soil samples may be collected from augerings." ;
