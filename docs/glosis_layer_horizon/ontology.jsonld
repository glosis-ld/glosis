  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/CementationDegree",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Cementation degree indicates the strength of the cemented material in a soil horizon. It ranges from weakly cemented, which can be broken with hand pressure, to strongly cemented, which resists breaking. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CementationDegree"
  } ],
