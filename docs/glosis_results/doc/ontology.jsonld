  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Soft segregation (or soft accumulation)"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/mineralConcKindValueCode-SC",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/MineralConcKindValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/MineralConcKindValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Soft concretion"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "SC"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Soft concretion"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/mineralConcKindValueCode-T",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/MineralConcKindValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/MineralConcKindValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Crystals in soil refer to solid, naturally occurring minerals that have a regular and repeating internal structure, which can often be seen under a microscope or with the naked eye. These crystal formations typically occur when minerals precipitate from water or melt and re-crystallize under certain environmental conditions, such as changes in temperature or pressure. Common crystal minerals in soil include quartz, gypsum, calcite, and halite. The presence of crystals in soil can significantly affect its properties, including drainage, fertility, and nutrient availability. For example, gypsum crystals can improve soil structure, while the presence of salt crystals can lead to soil salinity problems. Source: Brady & Weil (2017), The Nature and Properties of Soils."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "T"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Crystal"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/mineralConcNatureValueCode-C",
