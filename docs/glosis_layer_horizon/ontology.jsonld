}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/CalciumExchangeableBases",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Calcium exchangeable bases refer to calcium ions adsorbed on soil colloids that can be exchanged with other cations in the soil solution. Calcium is essential for soil structure and plant cell wall formation. Source: Soil Science Society of America (SSSA) Glossary."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
