#################################################################
#    Classes
#################################################################

###  http://w3id.org/glosis/model/codelists/results/BiologicalAbundanceValueCode
:BiologicalAbundanceValueCode rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Class ;
                                                    owl:oneOf ( :biologicalAbundanceValueCode-C
                                                                :biologicalAbundanceValueCode-F
                                                                :biologicalAbundanceValueCode-M
                                                                :biologicalAbundanceValueCode-N
                                                              )
                                                  ] ;
                              rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                              rdfs:comment "This code list class provides the BiologicalAbundanceValue codes."@en ;
                              rdfs:label "Code list for BiologicalAbundanceValue - codelist class"@en ;
                              rdfs:seeAlso :BiologicalAbundanceValueCollection ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Classification of the abundance of biological activity. See more in Guidelines for Soil Description issued by the FAO: table 81" .


###  http://w3id.org/glosis/model/codelists/results/BiologicalFeaturesValueCode
:BiologicalFeaturesValueCode rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:oneOf ( :biologicalFeaturesValueCode-A
                                                               :biologicalFeaturesValueCode-B
                                                               :biologicalFeaturesValueCode-BI
                                                               :biologicalFeaturesValueCode-BO
                                                               :biologicalFeaturesValueCode-C
                                                               :biologicalFeaturesValueCode-E
                                                               :biologicalFeaturesValueCode-I
                                                               :biologicalFeaturesValueCode-P
                                                               :biologicalFeaturesValueCode-T
                                                             )
                                                 ] ;
                             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                             rdfs:comment "This code list class provides the BiologicalFeaturesValue codes."@en ;
                             rdfs:label "Code list for BiologicalFeaturesValue - codelist class"@en ;
                             rdfs:seeAlso :BiologicalFeaturesValueCollection ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Examples of biological features. See more in Guidelines for Soil Description issued by the FAO: table 82" .


###  http://w3id.org/glosis/model/codelists/results/BleachedSandValueCode
:BleachedSandValueCode rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:oneOf ( :bleachedSandValueCode-0
                                                         :bleachedSandValueCode-1
                                                         :bleachedSandValueCode-2
                                                         :bleachedSandValueCode-3
                                                         :bleachedSandValueCode-4
                                                       )
                                           ] ;
                       rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                       rdfs:comment "This code list class provides the BleachedSandValue codes."@en ;
                       rdfs:label "Code list for BleachedSandValue - codelist class"@en ;
                       rdfs:seeAlso :BleachedSandValueCollection ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Classification of bleached sand characteristics based on the percentage of surface covered. See more in Guidelines for Soil Description issued by the FAO: table 23" .


###  http://w3id.org/glosis/model/codelists/results/BoundaryClassificationValueCode
:BoundaryClassificationValueCode rdf:type owl:Class ;
                                 owl:equivalentClass [ rdf:type owl:Class ;
                                                       owl:oneOf ( :boundaryClassificationValueCode-C
                                                                   :boundaryClassificationValueCode-D
                                                                   :boundaryClassificationValueCode-S
                                                                 )
                                                     ] ;
                                 rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                                 rdfs:comment "This code list class provides the BoundaryClassificationValue codes."@en ;
                                 rdfs:label "Code list for BoundaryClassificationValue - codelist class"@en ;
                                 rdfs:seeAlso :BoundaryClassificationValueCollection ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "The boundary between mottle and matrix is described as the thickness of the zone within which the colour transition can be located without being in either the mottle or matrix. See more in guidelines for Soil Description issued by the FAO: table 35" .


###  http://w3id.org/glosis/model/codelists/results/BoundaryDistinctnessValueCode
:BoundaryDistinctnessValueCode rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Class ;
                                                     owl:oneOf ( :boundaryDistinctnessValueCode-A
                                                                 :boundaryDistinctnessValueCode-C
                                                                 :boundaryDistinctnessValueCode-D
                                                                 :boundaryDistinctnessValueCode-G
                                                               )
                                                   ] ;
                               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                               rdfs:comment "This code list class provides the BoundaryDistinctnessValue codes."@en ;
                               rdfs:label "Code list for BoundaryDistinctnessValue - codelist class"@en ;
                               rdfs:seeAlso :BoundaryDistinctnessValueCollection ;
                               <http://www.w3.org/2004/02/skos/core#definition> "The distinctness of the boundary refers to the thickness of the zone in which the horizon boundary can be located without being in one of the adjacent horizons. See more in the  Guidelines for Soil Description issued by the FAO: table 24.1" .


###  http://w3id.org/glosis/model/codelists/results/BoundaryTopographyValueCode
:BoundaryTopographyValueCode rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:oneOf ( :boundaryTopographyValueCode-B
                                                               :boundaryTopographyValueCode-I
                                                               :boundaryTopographyValueCode-S
                                                               :boundaryTopographyValueCode-W
                                                             )
                                                 ] ;
                             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                             rdfs:comment "This code list class provides the BoundaryTopographyValue codes."@en ;
                             rdfs:label "Code list for BoundaryTopographyValue - codelist class"@en ;
                             rdfs:seeAlso :BoundaryTopographyValueCollection ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Classification of horizon boundaries by topography. See more in Guidelines for Soil Description issued by the FAO: table 24,2" .


###  http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCode
:BulkDensityMineralValueCode rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:oneOf ( :bulkDensityMineralValueCode-BD1
                                                               :bulkDensityMineralValueCode-BD2
                                                               :bulkDensityMineralValueCode-BD3
                                                               :bulkDensityMineralValueCode-BD4
                                                               :bulkDensityMineralValueCode-BD5
                                                             )
                                                 ] ;
                             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                             rdfs:comment "This code list class provides the BulkDensityMineralValue codes."@en ;
                             rdfs:label "Code list for BulkDensityMineralValue - codelist class"@en ;
                             rdfs:seeAlso :BulkDensityMineralValueCollection ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Field determinations of bulk density may be obtained by estimating the force required to push a knife into a soil horizon exposed at a field moist pit wall. See more in Guidelines for Soil Description issued by the FAO: table 58" .


###  http://w3id.org/glosis/model/codelists/results/BulkDensityPeatValueCode
:BulkDensityPeatValueCode rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( :bulkDensityPeatValueCode-BD1
                                                            :bulkDensityPeatValueCode-BD2
                                                            :bulkDensityPeatValueCode-BD3
                                                            :bulkDensityPeatValueCode-BD4
                                                            :bulkDensityPeatValueCode-BD5
                                                          )
                                              ] ;
                          rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                          rdfs:comment "This code list class provides the BulkDensityPeatValue codes."@en ;
                          rdfs:label "Code list for BulkDensityPeatValue - codelist class"@en ;
                          rdfs:seeAlso :BulkDensityPeatValueCollection ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Bulk density and volume of solids of organic soils can be estimated after the decomposition stage or the extent of peat drainage. See more in guidelines for Soil Description issued by the FAO: table 59,3" .


###  http://w3id.org/glosis/model/codelists/results/CarbonatesContentValueCode
:CarbonatesContentValueCode rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( :carbonatesContentValueCode-EX
                                                              :carbonatesContentValueCode-MO
                                                              :carbonatesContentValueCode-N
                                                              :carbonatesContentValueCode-SL
                                                              :carbonatesContentValueCode-ST
                                                            )
                                                ] ;
                            rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                            rdfs:comment "This code list class provides the CarbonatesContentValue codes."@en ;
                            rdfs:label "Code list for CarbonatesContentValue - codelist class"@en ;
                            rdfs:seeAlso :CarbonatesContentValueCollection ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Classes for the reaction of carbonates in the soil matrix. See more in Guidelines for Soil Description issued by the FAO: table 38" .


###  http://w3id.org/glosis/model/codelists/results/CarbonatesFormsValueCode
:CarbonatesFormsValueCode rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( :carbonatesFormsValueCode-D
                                                            :carbonatesFormsValueCode-HC
                                                            :carbonatesFormsValueCode-HHC
                                                            :carbonatesFormsValueCode-HL
                                                            :carbonatesFormsValueCode-M
                                                            :carbonatesFormsValueCode-PM
                                                            :carbonatesFormsValueCode-SC
                                                          )
                                              ] ;
                          rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                          rdfs:comment "This code list class provides the CarbonatesFormsValue codes."@en ;
                          rdfs:label "Code list for CarbonatesFormsValue - codelist class"@en ;
                          rdfs:seeAlso :CarbonatesFormsValueCollection ;
                          <http://www.w3.org/2004/02/skos/core#definition> "The forms of secondary carbonates in soils are diverse and are considered to be informative for diagnostics of soil genesis. See more in guidelines for Soil Description issued by the FAO: table 39" .


###  http://w3id.org/glosis/model/codelists/results/CementationContinuityValueCode
:CementationContinuityValueCode rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Class ;
                                                      owl:oneOf ( :cementationContinuityValueCode-B
                                                                  :cementationContinuityValueCode-C
                                                                  :cementationContinuityValueCode-D
                                                                )
                                                    ] ;
                                rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                                rdfs:comment "This code list class provides the CementationContinuityValue codes."@en ;
                                rdfs:label "Code list for CementationContinuityValue - codelist class"@en ;
                                rdfs:seeAlso :CementationContinuityValueCollection ;
                                <http://www.w3.org/2004/02/skos/core#definition> "The occurrence of cementation or compaction in pans or otherwise is described according to its nature, continuity, structure, agent and degree. See more in the guidelines for Soil Description issued by the FAO: table 69" .


###  http://w3id.org/glosis/model/codelists/results/CementationDegreeValueCode
:CementationDegreeValueCode rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( :cementationDegreeValueCode-C
                                                              :cementationDegreeValueCode-I
                                                              :cementationDegreeValueCode-M
                                                              :cementationDegreeValueCode-N
                                                              :cementationDegreeValueCode-W
                                                              :cementationDegreeValueCode-Y
                                                            )
                                                ] ;
                            rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                            rdfs:comment "This code list class provides the CementationDegreeValue codes."@en ;
                            rdfs:label "Code list for CementationDegreeValue - codelist class"@en ;
                            rdfs:seeAlso :CementationDegreeValueCollection ;
                            <http://www.w3.org/2004/02/skos/core#definition> "The classification of the degree of cementation/compaction. See more in Guidelines for Soil Description issued by the FAO: table 72" .


###  http://w3id.org/glosis/model/codelists/results/CementationFabricValueCode
:CementationFabricValueCode rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( :cementationFabricValueCode-D
                                                              :cementationFabricValueCode-Pi
