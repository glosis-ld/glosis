  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/VoidsClassification",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Voids classification describes the type and arrangement of voids or pores in the soil, which affects water movement, air circulation, and root penetration. It includes macropores, mesopores, and micropores. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "VoidsClassification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "_:genid767"
  }, {
    "@id" : "_:genid768"
  }, {
    "@id" : "_:genid772"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 61"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/VoidsDiameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Voids diameter measures the size of the soil pores or spaces, which directly influences soil aeration, infiltration, and water retention. Larger diameters correspond to macropores, while smaller ones are micropores. Source: Hillel, D. (2004). Introduction to Environmental Soil Physics."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "VoidsDiameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "_:genid773"
  }, {
    "@id" : "_:genid774"
  }, {
    "@id" : "_:genid778"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 62"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/WaterRetention",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Water retention refers to the soil’s ability to hold water against gravity. It is influenced by soil texture, structure, and organic matter content, and is critical for plant growth. Source: Brady, N.C., & Weil, R.R. (2008). The Nature and Properties of Soils."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "WaterRetention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
