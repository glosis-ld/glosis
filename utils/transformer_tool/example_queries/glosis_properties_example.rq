PREFIX owl:   <http://www.w3.org/2002/07/owl#> 
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX ssn:   <http://www.w3.org/ns/ssn/>
PREFIX glosis_prop: <http://w3id.org/glosis/model/codelists/properties/>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#> 
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbprop: <http://dbpedia.org/property/>
PREFIX glosis_pr: <http://w3id.org/glosis/model/profile/>
PREFIX glosis_lh: <http://w3id.org/glosis/model/layerhorizon/>
PREFIX glosis_sp: <http://w3id.org/glosis/model/siteplot/>
PREFIX glosis_su: <http://w3id.org/glosis/model/surface/>


CONSTRUCT {
### concept scheme
  glosis_prop: a skos:ConceptScheme ;
    skos:prefLabel ?cs_label ;
    rdfs:label ?cs_label ;
    skos:note ?cs_note ;
    .

### skos collection
  ?URI3 a skos:Collection ;
    rdfs:label ?c_label ;
    skos:scopeNote ?c_comment ;
    rdfs:seeAlso ?URI2 ;
    skos:member ?c_oneof ;
   .


### concept class
  ?URI2 a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:subClassOf ?c_property ;
    rdfs:label ?c_label ;
    rdfs:comment ?c_comment ;
    rdfs:seeAlso ?URI3 ;
    # the query omitts a collection connected to owl:oneOf on purpose, this will be
    # properly added in postprocessing phase due to the limitations of TARQL! 
   .  

### concepts
  ?c_oneof a skos:Concept; a ?compoundURI ; a ?substanceURI ;
    skos:prefLabel ?i_label ;
    skos:notation  ?i_notation ;
    skos:definition ?i_description ;
    skos:definition ?cs_definition ;
    skos:scopeNote ?i_reference ;
    skos:scopeNote ?i_citation ;
    skos:inScheme ?URI1 ;
    skos:broader ?broaderURI ;
    ssn:isPropertyOf ?foi_extracted ;
    # Chemical substances
    dbo:pubchem ?pub_chem_code ;
    dbo:inchi ?inchi_code ;
    dbprop:inchikey ?inchi_key_code ;
    rdfs:seeAlso ?pub_chem_URI ;
    .

  ?broaderURI skos:narrower ?c_oneof .
} 
WHERE {
    VALUES (?foi ?foi_extracted) {
    ("Profile" glosis_pr:GL_Profile)
    ("Layer-Horizon" glosis_lh:GL_Layer)
    ("Layer-Horizon" glosis_lh:GL_Horizon)
    ("Plot-Site" glosis_sp:GL_Plot)
    ("Plot-Site" glosis_sp:GL_Site)
    ("Surface" glosis_sp:GL_Surface)
  }
  BIND (URI(CONCAT('http://www.w3.org/ns/sosa/', "ObservableProperty")) AS ?c_property)
  BIND (URI('http://w3id.org/glosis/model/codelists/properties/') AS ?URI1)
  BIND (STRLANG(CONCAT('Code list for ', 'Glosis properties', ' - codelist scheme'),"en") AS ?cs_label)
  BIND (STRLANG(CONCAT('This code list provides possible values for ', 'glosis properties.'), "en") AS ?cs_note)
  BIND (CONCAT(UCASE(SUBSTR(?attribute, 1, 1)), SUBSTR(?attribute, 2)) AS ?attribute_capitalize)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/codelists/properties/', ?attribute_capitalize, 'Property', 'Code')) AS ?URI2)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/codelists/properties/', ?attribute_capitalize, 'Property', 'Collection')) AS ?URI3)
  BIND (STRLANG(CONCAT('Code list for ', ?attribute_capitalize, 'Property', ' - codelist class'),"en")  AS ?c_label)
  BIND (STRLANG(CONCAT('This code list provides the ', ?attribute_capitalize, 'Property', ' codes.'), "en") AS ?c_comment)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/codelists/properties/', ?attribute, 'Property', 'Code', '-', ?instance)) AS ?oneof)
  BIND (IF(?instance != '', ?oneof, ?nothing) AS ?c_oneof)
  BIND (STRLANG(?label, "en")  AS ?i_label)
  BIND (IF(?notation != '', ?notation, ?nothing) AS ?i_notation)
  BIND (IF(?definition != '', ?definition, ?nothing) AS ?i_description)
  BIND (IF(?definition != '', ?concept_definition, ?nothing) AS ?cs_definition)
  BIND (IF(?reference != '', URI(?reference), ?nothing)  AS ?i_reference)
  BIND (IF(?citation != '', ?citation, ?nothing) AS ?i_citation)
  BIND (IF(?parent_instance = '', ?URI1, ?nothing) AS ?top_URI)
  BIND (URI(CONCAT('http://w3id.org/glosis/model/codelists/properties/', ?attribute, 'Property', 'Code', '-', ?parent_instance)) AS ?parentURI)
  BIND (IF(?parent_instance != '', ?parentURI, ?nothing) AS ?broaderURI)
  BIND (IF(?pub_chem != '', ?pub_chem, ?nothing) AS ?pub_chem_code)
  BIND (IF(?pub_chem != '', URI(CONCAT('https://pubchem.ncbi.nlm.nih.gov/compound/', ?pub_chem)), ?nothing) AS ?pub_chem_URI)
  BIND (IF(?pub_chem != '', dbo:ChemicalSubstance, ?nothing) AS ?substanceURI)
  BIND (IF(?inchi_key != '', ?inchi_key, ?nothing) AS ?inchi_key_code)
  BIND (IF(?inchi != '', ?inchi, ?nothing) AS ?inchi_code)
  BIND (IF(?pub_chem != '', dbo:ChemicalCompound, ?nothing) AS ?compoundURI)
  FILTER(BOUND(?foi_extracted))
}
