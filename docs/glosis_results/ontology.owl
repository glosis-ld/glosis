        <skos:note xml:lang="en">This code list collection provides the GypsumContentValue codes.</skos:note>
        <skos:prefLabel xml:lang="en">Code list for GypsumContentValue - codelist collection</skos:prefLabel>
    </owl:NamedIndividual>
    


