    <!-- http://w3id.org/glosis/model/codelists/results/TextureUnconsolidatedValueCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/results/TextureUnconsolidatedValueCode">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">This code list class provides the TextureUnconsolidatedValue codes.</rdfs:comment>
