    skos:inScheme glosis_res:cracksDistanceValueCode ;
    skos:notation "D" ;
    skos:prefLabel "Closely spaced 0.2–0.5"@en ;
    skos:topConceptOf glosis_res:cracksDistanceValueCode .

glosis_res:cracksDistanceValueCode-M a glosis_res:CracksDistanceValueCode,
        skos:Concept ;
