    <!-- http://w3id.org/glosis/model/codelists/results/TextureUnconsolidatedValueCollection -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/results/TextureUnconsolidatedValueCollection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/results/TextureUnconsolidatedValueCode"/>
        <skos:definition>Texture of a soil that is unconsolidated or loose, typically not bound into a compact mass. It describes the proportions of sand, silt, and clay in the soil, which directly influences the soil&apos;s physical properties such as water retention, aeration, and fertility. This texture classification can impact various soil management practices, such as tillage, irrigation, and erosion control. Source: Canadian Soil Information Service - chapter 17 &amp; Geosciences libretexts - 3.1: Soil Texture and Structure. Possible values include unconsolidated Sand,Silt, Clay, Loam. Silty Sand, Clayey Sand</skos:definition>
        <skos:note xml:lang="en">This code list collection provides the TextureUnconsolidatedValue codes.</skos:note>
        <skos:prefLabel xml:lang="en">Code list for TextureUnconsolidatedValue - codelist collection</skos:prefLabel>
    </owl:NamedIndividual>
    


