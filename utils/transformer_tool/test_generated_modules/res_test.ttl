glosis_res:consistenceDryValueCode-EHA a glosis_res:ConsistenceDryValueCode,
        skos:Concept ;
    skos:definition "“Extremely resistant to pressure,  cannot be broken in the hands.”" ;
    skos:inScheme glosis_res:consistenceDryValueCode ;
    skos:notation "EHA" ;
    skos:prefLabel "Extremely hard"@en ;
    skos:topConceptOf glosis_res:consistenceDryValueCode .

glosis_res:consistenceDryValueCode-HA a glosis_res:ConsistenceDryValueCode,
        skos:Concept ;
    skos:definition "“Moderately resistant to pressure,  can be broken in the hands,  not breakable between thumb and forefinger.”" ;
    skos:inScheme glosis_res:consistenceDryValueCode ;
    skos:notation "HA" ;
    skos:prefLabel "Hard"@en ;
    skos:topConceptOf glosis_res:consistenceDryValueCode .

