    <owl:Ontology rdf:about="http://w3id.org/glosis/model/layerhorizon">
        <owl:versionIRI rdf:resource="http://w3id.org/glosis/model/layerhorizon/2.0.0"/>
        <owl:imports rdf:resource="http://w3id.org/glosis/model/codelists/properties/"/>
