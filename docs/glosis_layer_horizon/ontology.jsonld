  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coating abundance refers to the quantity or percentage of coatings (e.g., clay films, oxide layers) on soil particles or aggregates. Coatings indicate soil movement and development processes. Source: Soil Survey Manual (USDA, 2017)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CoatingAbundance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "_:genid265"
  }, {
    "@id" : "_:genid266"
  }, {
    "@id" : "_:genid270"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 64"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/CoatingContrast",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coating contrast describes the degree of visual distinction between coatings and the surrounding soil matrix. It may range from faint to prominent. Source: Soil Survey Manual (USDA, 2017)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CoatingContrast"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "_:genid271"
  }, {
    "@id" : "_:genid272"
  }, {
    "@id" : "_:genid276"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 65"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/CoatingForm",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coating form refers to the specific physical shape or arrangement of soil coatings, such as laminar films, streaks, or bridges between particles. Source: Soil Survey Manual (USDA, 2017)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CoatingForm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "_:genid277"
  }, {
    "@id" : "_:genid278"
  }, {
    "@id" : "_:genid282"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 67"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/CoatingLocation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coating location indicates where the coating appears within the soil, such as on aggregate surfaces, pore walls, or within soil matrix voids. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CoatingLocation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
