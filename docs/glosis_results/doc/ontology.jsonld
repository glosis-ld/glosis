    "@value" : "BD1"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Many pores, moist materials drop easily out of the auger."
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCollection"
