    skos:prefLabel "Aluminium (Al) saturation"@en ;
    skos:topConceptOf glosis_pch:physioChemicalPropertyCode .

glosis_pch:physioChemicalPropertyCode-Alutot a dbo:ChemicalCompound,
        dbo:ChemicalSubstance,
