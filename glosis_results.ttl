    rdfs:seeAlso glosis_res:SurfaceAgeValueCollection ;
    rdfs:subClassOf skos:Concept ;
    owl:oneOf ( glosis_res:surfaceAgeValueCode-T glosis_res:surfaceAgeValueCode-oPf glosis_res:surfaceAgeValueCode-Ha glosis_res:surfaceAgeValueCode-Ya glosis_res:surfaceAgeValueCode-oPp glosis_res:surfaceAgeValueCode-Yn glosis_res:surfaceAgeValueCode-lPi glosis_res:surfaceAgeValueCode-oPi glosis_res:surfaceAgeValueCode-lPp glosis_res:surfaceAgeValueCode-O glosis_res:surfaceAgeValueCode-vYa glosis_res:surfaceAgeValueCode-vYn glosis_res:surfaceAgeValueCode-lPf glosis_res:surfaceAgeValueCode-Hn ) ;
    skos:definition "The age of the landscape is important information from which the possible duration of the occurrence of soil formation processes can be derived. See more in guidelines for Soil Description issued by the FAO: table 13" .

glosis_res:TextureUnconsolidatedValueCode a owl:Class ;
    rdfs:label "Code list for TextureUnconsolidatedValue - codelist class"@en ;
    rdfs:comment "This code list provides the TextureUnconsolidatedValue codes."@en ;
    rdfs:seeAlso glosis_res:TextureUnconsolidatedValueCollection ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Texture of a soil that is unconsolidated or loose, typically not bound into a compact mass. It describes the proportions of sand, silt, and clay in the soil, which directly influences the soil's physical properties such as water retention, aeration, and fertility. This texture classification can impact various soil management practices, such as tillage, irrigation, and erosion control. Source: Canadian Soil Information Service - chapter 17 & Geosciences libretexts - 3.1: Soil Texture and Structure. Possible values include unconsolidated Sand,Silt, Clay, Loam. Silty Sand, Clayey Sand" .

glosis_res:VegetationClassValueCode a owl:Class ;
    rdfs:label "Code list for VegetationClassValue - codelist class"@en ;
    rdfs:comment "This code list provides the VegetationClassValue codes."@en ;
    rdfs:seeAlso glosis_res:VegetationClassValueCollection ;
    rdfs:subClassOf skos:Concept ;
    owl:oneOf ( glosis_res:vegetationClassValueCode-FS glosis_res:vegetationClassValueCode-WD glosis_res:vegetationClassValueCode-WX glosis_res:vegetationClassValueCode-FX glosis_res:vegetationClassValueCode-SS glosis_res:vegetationClassValueCode-F glosis_res:vegetationClassValueCode-HS glosis_res:vegetationClassValueCode-D glosis_res:vegetationClassValueCode-SE glosis_res:vegetationClassValueCode-DS glosis_res:vegetationClassValueCode-FE glosis_res:vegetationClassValueCode-HT glosis_res:vegetationClassValueCode-SX glosis_res:vegetationClassValueCode-FD glosis_res:vegetationClassValueCode-SD glosis_res:vegetationClassValueCode-H glosis_res:vegetationClassValueCode-FC glosis_res:vegetationClassValueCode-HF glosis_res:vegetationClassValueCode-DE glosis_res:vegetationClassValueCode-S glosis_res:vegetationClassValueCode-B glosis_res:vegetationClassValueCode-M glosis_res:vegetationClassValueCode-DX glosis_res:vegetationClassValueCode-DD glosis_res:vegetationClassValueCode-DT glosis_res:vegetationClassValueCode-WE glosis_res:vegetationClassValueCode-HM glosis_res:vegetationClassValueCode-W glosis_res:vegetationClassValueCode-WS ) ;
    skos:definition "Classification of vegetation.See more in Guidelines for Soil Description issued by the FAO: table 11" .

glosis_res:VoidsClassificationValueCode a owl:Class ;
    rdfs:label "Code list for VoidsClassificationValue - codelist class"@en ;
    rdfs:comment "This code list provides the VoidsClassificationValue codes."@en ;
    rdfs:seeAlso glosis_res:VoidsClassificationValueCollection ;
    rdfs:subClassOf skos:Concept ;
    owl:oneOf ( glosis_res:voidsClassificationValueCode-C glosis_res:voidsClassificationValueCode-I glosis_res:voidsClassificationValueCode-P glosis_res:voidsClassificationValueCode-B glosis_res:voidsClassificationValueCode-V ) ;
    skos:definition "Voids include all empty spaces in the soil. They are related to the arrangement of the primary soil constituents, rooting patterns, burrowing of animals or any other soil-forming processes, such as cracking, translocation and leaching. See more in Guidelines for Soil Description issued by the FAO: table 61" .

glosis_res:VoidsDiameterValueCode a owl:Class ;
    rdfs:label "Code list for VoidsDiameterValue - codelist class"@en ;
    rdfs:comment "This code list provides the VoidsDiameterValue codes."@en ;
    rdfs:seeAlso glosis_res:VoidsDiameterValueCollection ;
    rdfs:subClassOf skos:Concept ;
    owl:oneOf ( glosis_res:voidsDiameterValueCode-MC glosis_res:voidsDiameterValueCode-VC glosis_res:voidsDiameterValueCode-M glosis_res:voidsDiameterValueCode-FM glosis_res:voidsDiameterValueCode-V glosis_res:voidsDiameterValueCode-FF glosis_res:voidsDiameterValueCode-C glosis_res:voidsDiameterValueCode-F ) ;
    skos:definition "Voids include all empty spaces in the soil. They are related to the arrangement of the primary soil constituents, rooting patterns, burrowing of animals or any other soil-forming processes, such as cracking, translocation and leaching. See more in Guidelines for Soil Description issued by the FAO: table 62" .

