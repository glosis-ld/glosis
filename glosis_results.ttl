        glosis_res:gypsumFormsValueCode-G,
        glosis_res:gypsumFormsValueCode-HL,
        glosis_res:gypsumFormsValueCode-SC ;
    skos:note "This code list provides the GypsumFormsValue codes."@en ;
    skos:prefLabel "Code list for GypsumFormsValue - codelist class"@en .

