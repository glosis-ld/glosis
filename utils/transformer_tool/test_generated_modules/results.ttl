        skos:Concept ;
    skos:definition "The total area affected by erosion is zero" ;
    skos:inScheme glosis_cl:erosionTotalAreaAffectedValueCode ;
    skos:notation "0" ;
    skos:prefLabel "Zero"@en ;
    skos:topConceptOf glosis_cl:erosionTotalAreaAffectedValueCode .

