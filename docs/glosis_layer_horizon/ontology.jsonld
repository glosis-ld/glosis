    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/FragmentsClass",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Fragments class refers to the classification of coarse fragments in soil based on size and type, such as gravel, cobbles, stones, or boulders. Source: Soil Survey Manual (USDA, 2017)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
