    skos:definition "0%–2% of coarse surface fragments" ;
    skos:inScheme glosis_cl:fragmentCoverValueCode ;
    skos:notation "V" ;
    skos:prefLabel "Very few"@en ;
    skos:topConceptOf glosis_cl:fragmentCoverValueCode .

