  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 70"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/CementationNature",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Cementation nature refers to the composition and type of cementing agents present in the soil, such as calcium carbonate, silica, or iron oxides, and their impact on soil properties. Source: Soil Survey Manual (USDA, 2017)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
