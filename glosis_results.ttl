    skos:inScheme glosis_res: ;
    skos:notation "D" ;
    skos:prefLabel "disperse powdery gypsum"@en .

glosis_res:gypsumFormsValueCode-G a glosis_res:GypsumFormsValueCode,
        skos:Concept ;
