  }, {
    "@id" : "_:genid340"
  }, {
    "@id" : "_:genid341"
  }, {
    "@id" : "_:genid342"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/Gypsum",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Gypsum refers to calcium sulfate dihydrate (CaSO₄·2H₂O) in the soil, which can occur naturally or through amendments. It influences soil structure, fertility, and salinity management. Source: Soil Science Society of America (SSSA) Glossary."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Gypsum"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/glosis/model/layerhorizon/PhysioChemical"
  }, {
    "@id" : "_:genid343"
  }, {
    "@id" : "_:genid344"
  }, {
    "@id" : "_:genid345"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/GypsumContent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Gypsum content measures the proportion of gypsum present in a soil sample. High gypsum levels can affect soil water retention and cause structural instability when dissolved. Source: FAO (2006). Guidelines for Soil Description."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "GypsumContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "_:genid346"
  }, {
    "@id" : "_:genid347"
  }, {
    "@id" : "_:genid351"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 40"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/GypsumForms",
