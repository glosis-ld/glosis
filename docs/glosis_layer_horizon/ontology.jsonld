  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 59,3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/BulkDensityWholeSoil",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Bulk density whole soil is the dry mass of the entire soil sample, including both fine earth and coarse fragments. It reflects total soil compaction and space available for roots and water. Source: Brady, N.C., & Weil, R.R. (2017). The Nature and Properties of Soils."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "BulkDensityWholeSoil"
  } ],
