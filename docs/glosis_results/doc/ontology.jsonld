}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/FloodDurationValueCode",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This code list class provides the FloodDurationValue codes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Code list for FloodDurationValue - codelist class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/FloodDurationValueCollection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Related to the amount of time an area remains inundated by floodwater.  This metric is important because it helps assess the extent of waterlogging and its impact on soil properties, particularly in terms of oxygen availability and soil aeration. Flood duration affects the mobility of nutrients and contaminants within the soil, influencing both agricultural productivity and environmental quality. Longer flood durations can also lead to changes in soil texture and structure due to the continuous movement and deposition of particles during inundation​. Source: Guidance for Flood Risk Analysis and Mapping"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/FloodDurationValueCollection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Collection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/FloodDurationValueCode"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Related to the amount of time an area remains inundated by floodwater.  This metric is important because it helps assess the extent of waterlogging and its impact on soil properties, particularly in terms of oxygen availability and soil aeration. Flood duration affects the mobility of nutrients and contaminants within the soil, influencing both agricultural productivity and environmental quality. Longer flood durations can also lead to changes in soil texture and structure due to the continuous movement and deposition of particles during inundation​. Source: Guidance for Flood Risk Analysis and Mapping"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "This code list collection provides the FloodDurationValue codes."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Code list for FloodDurationValue - codelist collection"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/FloodFrequencyValueCode",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This code list class provides the FloodFrequencyValue codes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Code list for FloodFrequencyValue - codelist class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/FloodFrequencyValueCollection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Refers to the statistical analysis of the occurrence of floods at a particular location over a defined time period. It often involves calculating the recurrence intervals or return periods of flood events, which are typically used to understand how often a specific flood magnitude (like a 100-year flood) is likely to occur. Source: Introduction to Flood Frequency Analysis"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/FloodFrequencyValueCollection",
