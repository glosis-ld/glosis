    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 72"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/CementationFabric",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Cementation fabric describes the internal arrangement of cemented materials, including the texture, layering, and structural patterns formed by cementing agents like carbonates or oxides. Source: Soil Classification: A Global Desk Reference (Eswaran et al., 2003)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CementationFabric"
  } ],
