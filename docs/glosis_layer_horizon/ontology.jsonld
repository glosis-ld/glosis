}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/BulkDensityMineral",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Bulk density mineral refers to the dry bulk density of mineral soils, focusing on soils with minimal organic matter content. It affects soil strength, aeration, and compaction. Source: Soil Science Society of America (SSSA) Glossary."
  } ],
