  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Soluble salts are salts dissolved in the soil solution that can move with water. Excessive soluble salts cause salinity, which impacts plant growth. Source: Soil Science Society of America (SSSA) Glossary."
