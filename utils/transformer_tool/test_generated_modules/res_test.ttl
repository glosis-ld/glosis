        glosis_res:cropClassValueCode-Fr_Gr,
        glosis_res:cropClassValueCode-Fr_Ma,
        glosis_res:cropClassValueCode-Fr_Me ;
    skos:notation "Fr" ;
    skos:prefLabel "Fruits and melons"@en ;
    skos:topConceptOf glosis_res:cropClassValueCode .

glosis_res:erosionCategoryValueCode-W a glosis_res:ErosionCategoryValueCode,
        skos:Concept ;
    dbo:inchi "None" ;
