        <skos:definition>Weak to moderate</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>WM</skos:notation>
        <skos:prefLabel xml:lang="en">Weak to moderate</skos:prefLabel>
    </owl:NamedIndividual>
    


