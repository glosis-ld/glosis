@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix glosis_res: <http://w3id.org/glosis/model/codelists/results/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

glosis_res: a owl:Ontology,
        skos:ConceptScheme ;
    rdfs:label "Code list for Glosis results - codelist scheme"@en ;
    dct:creator [ rdfs:seeAlso <http://orcid.org/0000-0003-4289-4922> ;
            foaf:name "Raul Palma" ;
            schema:affiliation [ foaf:name "PSNC" ] ],
        [ foaf:name "Bogusz Janiak" ;
            schema:affiliation [ foaf:name "PSNC" ] ],
        [ rdfs:seeAlso <http://orcid.org/0000-0002-5851-2071> ;
            foaf:name "Luís Moreira de Sousa" ;
            schema:affiliation [ foaf:name "Técnico ULisboa" ] ] ;
    dct:description "This ontology represents GLOSIS code lists results extracted from the data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en ;
    dct:rights "This ontology is distributed under Creative Commons Attribution-NonCommercial-ShareAlike 3.0 IGO License - https://creativecommons.org/licenses/by-nc-sa/3.0/igo/"@en ;
    dct:source "Data model for the Global Soil Information System (GloSIS) v1.0, edited by Tomas Reznik and Katharina Schleidt"@en ;
    dct:title "GLOSIS code lists results"@en ;
    rdfs:comment "This module contains all the code lists of results codes."@en ;
    owl:versionIRI glosis_res:1.5.1 ;
    owl:versionInfo "1.5.1" ;
    skos:note "This code list provides possible values for glosis results."@en ;
    skos:prefLabel "Code list for Glosis results - codelist scheme"@en .

glosis_res:BiologicalAbundanceValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:BiologicalAbundanceValueCode ;
    skos:definition "Classification of the abundance of biological activity. See more in Guidelines for Soil Description issued by the FAO: table 81" ;
    skos:member glosis_res:biologicalAbundanceValueCode-C,
        glosis_res:biologicalAbundanceValueCode-F,
        glosis_res:biologicalAbundanceValueCode-M,
        glosis_res:biologicalAbundanceValueCode-N ;
    skos:note "This code list provides the BiologicalAbundanceValue codes."@en ;
    skos:prefLabel "Code list for BiologicalAbundanceValue - codelist class"@en .

glosis_res:BiologicalFeaturesValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:BiologicalFeaturesValueCode ;
    skos:definition "Examples of biological features. See more in Guidelines for Soil Description issued by the FAO: table 82" ;
    skos:member glosis_res:biologicalFeaturesValueCode-A,
        glosis_res:biologicalFeaturesValueCode-B,
        glosis_res:biologicalFeaturesValueCode-BI,
        glosis_res:biologicalFeaturesValueCode-BO,
        glosis_res:biologicalFeaturesValueCode-C,
        glosis_res:biologicalFeaturesValueCode-E,
        glosis_res:biologicalFeaturesValueCode-I,
        glosis_res:biologicalFeaturesValueCode-P,
        glosis_res:biologicalFeaturesValueCode-T ;
    skos:note "This code list provides the BiologicalFeaturesValue codes."@en ;
    skos:prefLabel "Code list for BiologicalFeaturesValue - codelist class"@en .

glosis_res:BleachedSandValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:BleachedSandValueCode ;
    skos:definition "Classification of bleached sand characteristics based on the percentage of surface covered. See more in Guidelines for Soil Description issued by the FAO: table 23" ;
    skos:member glosis_res:bleachedSandValueCode-0,
        glosis_res:bleachedSandValueCode-1,
        glosis_res:bleachedSandValueCode-2,
        glosis_res:bleachedSandValueCode-3,
        glosis_res:bleachedSandValueCode-4 ;
    skos:note "This code list provides the BleachedSandValue codes."@en ;
    skos:prefLabel "Code list for BleachedSandValue - codelist class"@en .

glosis_res:BoundaryClassificationValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:BoundaryClassificationValueCode ;
    skos:definition "The boundary between mottle and matrix is described as the thickness of the zone within which the colour transition can be located without being in either the mottle or matrix. See more in guidelines for Soil Description issued by the FAO: table 35" ;
    skos:member glosis_res:boundaryClassificationValueCode-C,
        glosis_res:boundaryClassificationValueCode-D,
        glosis_res:boundaryClassificationValueCode-S ;
    skos:note "This code list provides the BoundaryClassificationValue codes."@en ;
    skos:prefLabel "Code list for BoundaryClassificationValue - codelist class"@en .

glosis_res:BoundaryDistinctnessValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:BoundaryDistinctnessValueCode ;
    skos:definition "The distinctness of the boundary refers to the thickness of the zone in which the horizon boundary can be located without being in one of the adjacent horizons. See more in the  Guidelines for Soil Description issued by the FAO: table 24.1" ;
    skos:member glosis_res:boundaryDistinctnessValueCode-A,
        glosis_res:boundaryDistinctnessValueCode-C,
        glosis_res:boundaryDistinctnessValueCode-D,
        glosis_res:boundaryDistinctnessValueCode-G ;
    skos:note "This code list provides the BoundaryDistinctnessValue codes."@en ;
    skos:prefLabel "Code list for BoundaryDistinctnessValue - codelist class"@en .

glosis_res:BoundaryTopographyValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:BoundaryTopographyValueCode ;
    skos:definition "Classification of horizon boundaries by topography. See more in Guidelines for Soil Description issued by the FAO: table 24,2" ;
    skos:member glosis_res:boundaryTopographyValueCode-B,
        glosis_res:boundaryTopographyValueCode-I,
        glosis_res:boundaryTopographyValueCode-S,
        glosis_res:boundaryTopographyValueCode-W ;
    skos:note "This code list provides the BoundaryTopographyValue codes."@en ;
    skos:prefLabel "Code list for BoundaryTopographyValue - codelist class"@en .

glosis_res:BulkDensityMineralValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:BulkDensityMineralValueCode ;
    skos:definition "Field determinations of bulk density may be obtained by estimating the force required to push a knife into a soil horizon exposed at a field moist pit wall. See more in Guidelines for Soil Description issued by the FAO: table 58" ;
    skos:member glosis_res:bulkDensityMineralValueCode-BD1,
        glosis_res:bulkDensityMineralValueCode-BD2,
        glosis_res:bulkDensityMineralValueCode-BD3,
        glosis_res:bulkDensityMineralValueCode-BD4,
        glosis_res:bulkDensityMineralValueCode-BD5 ;
    skos:note "This code list provides the BulkDensityMineralValue codes."@en ;
    skos:prefLabel "Code list for BulkDensityMineralValue - codelist class"@en .

glosis_res:BulkDensityPeatValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:BulkDensityPeatValueCode ;
    skos:definition "Bulk density and volume of solids of organic soils can be estimated after the decomposition stage or the extent of peat drainage. See more in guidelines for Soil Description issued by the FAO: table 59,3" ;
    skos:member glosis_res:bulkDensityPeatValueCode-BD1,
        glosis_res:bulkDensityPeatValueCode-BD2,
        glosis_res:bulkDensityPeatValueCode-BD3,
        glosis_res:bulkDensityPeatValueCode-BD4,
        glosis_res:bulkDensityPeatValueCode-BD5 ;
    skos:note "This code list provides the BulkDensityPeatValue codes."@en ;
    skos:prefLabel "Code list for BulkDensityPeatValue - codelist class"@en .

glosis_res:CarbonatesContentValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CarbonatesContentValueCode ;
    skos:definition "Classes for the reaction of carbonates in the soil matrix. See more in Guidelines for Soil Description issued by the FAO: table 38" ;
    skos:member glosis_res:carbonatesContentValueCode-EX,
        glosis_res:carbonatesContentValueCode-MO,
        glosis_res:carbonatesContentValueCode-N,
        glosis_res:carbonatesContentValueCode-SL,
        glosis_res:carbonatesContentValueCode-ST ;
    skos:note "This code list provides the CarbonatesContentValue codes."@en ;
    skos:prefLabel "Code list for CarbonatesContentValue - codelist class"@en .

glosis_res:CarbonatesFormsValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CarbonatesFormsValueCode ;
    skos:definition "The forms of secondary carbonates in soils are diverse and are considered to be informative for diagnostics of soil genesis. See more in guidelines for Soil Description issued by the FAO: table 39" ;
    skos:member glosis_res:carbonatesFormsValueCode-D,
        glosis_res:carbonatesFormsValueCode-HC,
        glosis_res:carbonatesFormsValueCode-HHC,
        glosis_res:carbonatesFormsValueCode-HL,
        glosis_res:carbonatesFormsValueCode-M,
        glosis_res:carbonatesFormsValueCode-PM,
        glosis_res:carbonatesFormsValueCode-SC ;
    skos:note "This code list provides the CarbonatesFormsValue codes."@en ;
    skos:prefLabel "Code list for CarbonatesFormsValue - codelist class"@en .

glosis_res:CementationContinuityValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CementationContinuityValueCode ;
    skos:definition "The occurrence of cementation or compaction in pans or otherwise is described according to its nature, continuity, structure, agent and degree. See more in the guidelines for Soil Description issued by the FAO: table 69" ;
    skos:member glosis_res:cementationContinuityValueCode-B,
        glosis_res:cementationContinuityValueCode-C,
        glosis_res:cementationContinuityValueCode-D ;
    skos:note "This code list provides the CementationContinuityValue codes."@en ;
    skos:prefLabel "Code list for CementationContinuityValue - codelist class"@en .

glosis_res:CementationDegreeValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CementationDegreeValueCode ;
    skos:definition "The classification of the degree of cementation/compaction. See more in Guidelines for Soil Description issued by the FAO: table 72" ;
    skos:member glosis_res:cementationDegreeValueCode-C,
        glosis_res:cementationDegreeValueCode-I,
        glosis_res:cementationDegreeValueCode-M,
        glosis_res:cementationDegreeValueCode-N,
        glosis_res:cementationDegreeValueCode-W,
        glosis_res:cementationDegreeValueCode-Y ;
    skos:note "This code list provides the CementationDegreeValue codes."@en ;
    skos:prefLabel "Code list for CementationDegreeValue - codelist class"@en .

glosis_res:CementationFabricValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CementationFabricValueCode ;
    skos:definition "Classification of the fabric of the cemented/compacted layer. See more in Guidelines for Soil Description issued by the FAO: table 70" ;
    skos:member glosis_res:cementationFabricValueCode-D,
        glosis_res:cementationFabricValueCode-Pi,
        glosis_res:cementationFabricValueCode-Pl,
        glosis_res:cementationFabricValueCode-V ;
    skos:note "This code list provides the CementationFabricValue codes."@en ;
    skos:prefLabel "Code list for CementationFabricValue - codelist class"@en .

glosis_res:CementationNatureValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CementationNatureValueCode ;
    skos:definition "Classification of the nature of cementation/compaction. See more in Guidelines for Soil Description issued by the FAO: table 71" ;
    skos:member glosis_res:cementationNatureValueCode-C,
        glosis_res:cementationNatureValueCode-CS,
        glosis_res:cementationNatureValueCode-F,
        glosis_res:cementationNatureValueCode-FM,
        glosis_res:cementationNatureValueCode-FO,
        glosis_res:cementationNatureValueCode-GY,
        glosis_res:cementationNatureValueCode-I,
        glosis_res:cementationNatureValueCode-K,
        glosis_res:cementationNatureValueCode-KQ,
        glosis_res:cementationNatureValueCode-M,
        glosis_res:cementationNatureValueCode-NK,
        glosis_res:cementationNatureValueCode-P,
        glosis_res:cementationNatureValueCode-Q ;
    skos:note "This code list provides the CementationNatureValue codes."@en ;
    skos:prefLabel "Code list for CementationNatureValue - codelist class"@en .

glosis_res:CoatingAbundanceValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CoatingAbundanceValueCode ;
    skos:definition "Classification of abundance of coatings. See more in Guidelines for Soil Description issued by the FAO: table 64" ;
    skos:member glosis_res:coatingAbundanceValueCode-A,
        glosis_res:coatingAbundanceValueCode-C,
        glosis_res:coatingAbundanceValueCode-D,
        glosis_res:coatingAbundanceValueCode-F,
        glosis_res:coatingAbundanceValueCode-M,
        glosis_res:coatingAbundanceValueCode-N,
        glosis_res:coatingAbundanceValueCode-V ;
    skos:note "This code list provides the CoatingAbundanceValue codes."@en ;
    skos:prefLabel "Code list for CoatingAbundanceValue - codelist class"@en .

glosis_res:CoatingContrastValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CoatingContrastValueCode ;
    skos:definition "Classification of the contrast of coatings. See more in Guidelines for Soil Description issued by the FAO: table 65" ;
    skos:member glosis_res:coatingContrastValueCode-D,
        glosis_res:coatingContrastValueCode-F,
        glosis_res:coatingContrastValueCode-P ;
    skos:note "This code list provides the CoatingContrastValue codes."@en ;
    skos:prefLabel "Code list for CoatingContrastValue - codelist class"@en .

glosis_res:CoatingFormValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CoatingFormValueCode ;
    skos:definition "Classification of the form of coatings. See more in Guidelines for Soil Description issued by the FAO: table 67" ;
    skos:member glosis_res:coatingFormValueCode-C,
        glosis_res:coatingFormValueCode-CI,
        glosis_res:coatingFormValueCode-DC,
        glosis_res:coatingFormValueCode-DE,
        glosis_res:coatingFormValueCode-DI,
        glosis_res:coatingFormValueCode-O ;
    skos:note "This code list provides the CoatingFormValue codes."@en ;
    skos:prefLabel "Code list for CoatingFormValue - codelist class"@en .

glosis_res:CoatingLocationValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CoatingLocationValueCode ;
    skos:definition "Classification of the location of coatings and clay accumulation. See more in Guidelines for Soil Description issued by the FAO: table 68" ;
    skos:member glosis_res:coatingLocationValueCode-BR,
        glosis_res:coatingLocationValueCode-CF,
        glosis_res:coatingLocationValueCode-LA,
        glosis_res:coatingLocationValueCode-NS,
        glosis_res:coatingLocationValueCode-P,
        glosis_res:coatingLocationValueCode-PH,
        glosis_res:coatingLocationValueCode-PV,
        glosis_res:coatingLocationValueCode-VO ;
    skos:note "This code list provides the CoatingLocationValue codes."@en ;
    skos:prefLabel "Code list for CoatingLocationValue - codelist class"@en .

glosis_res:CoatingNatureValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CoatingNatureValueCode ;
    skos:definition "Classification of the nature of coatings. See more in Guidelines for Soil Description issued by the FAO: table 66" ;
    skos:member glosis_res:coatingNatureValueCode-C,
        glosis_res:coatingNatureValueCode-CC,
        glosis_res:coatingNatureValueCode-CH,
        glosis_res:coatingNatureValueCode-CS,
        glosis_res:coatingNatureValueCode-GB,
        glosis_res:coatingNatureValueCode-H,
        glosis_res:coatingNatureValueCode-HC,
        glosis_res:coatingNatureValueCode-JA,
        glosis_res:coatingNatureValueCode-MN,
        glosis_res:coatingNatureValueCode-PF,
        glosis_res:coatingNatureValueCode-S,
        glosis_res:coatingNatureValueCode-SA,
        glosis_res:coatingNatureValueCode-SF,
        glosis_res:coatingNatureValueCode-SI,
        glosis_res:coatingNatureValueCode-SL,
        glosis_res:coatingNatureValueCode-SN,
        glosis_res:coatingNatureValueCode-SP,
        glosis_res:coatingNatureValueCode-ST ;
    skos:note "This code list provides the CoatingNatureValue codes."@en ;
    skos:prefLabel "Code list for CoatingNatureValue - codelist class"@en .

glosis_res:ConsistenceDryValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:ConsistenceDryValueCode ;
    skos:definition "The consistence when dry is determined by breaking an air-dried mass of soil between thumb and forefinger or in the hand. See more in the guidelines for Soil Description issued by the FAO: table 53" ;
    skos:member glosis_res:consistenceDryValueCode-EHA,
        glosis_res:consistenceDryValueCode-HA,
        glosis_res:consistenceDryValueCode-HVH,
        glosis_res:consistenceDryValueCode-LO,
        glosis_res:consistenceDryValueCode-SHA,
        glosis_res:consistenceDryValueCode-SHH,
        glosis_res:consistenceDryValueCode-SO,
        glosis_res:consistenceDryValueCode-SSH,
        glosis_res:consistenceDryValueCode-VHA ;
    skos:note "This code list provides the ConsistenceDryValue codes."@en ;
    skos:prefLabel "Code list for ConsistenceDryValue - codelist class"@en .

glosis_res:ConsistenceMoistValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:ConsistenceMoistValueCode ;
    skos:definition "Guidelines for Soil Description issued by the FAO: table 54,Consistence when moist is determined by attempting to crush a mass of moist or slightly moist soil material. See more in Guidelines for Soil Description issued by the FAO: table 54" ;
    skos:member glosis_res:consistenceMoistValueCode-EFI,
        glosis_res:consistenceMoistValueCode-FI,
        glosis_res:consistenceMoistValueCode-FR,
        glosis_res:consistenceMoistValueCode-LO,
        glosis_res:consistenceMoistValueCode-VFI,
        glosis_res:consistenceMoistValueCode-VFR ;
    skos:note "This code list provides the ConsistenceMoistValue codes."@en ;
    skos:prefLabel "Code list for ConsistenceMoistValue - codelist class"@en .

glosis_res:ContrastValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:ContrastValueCode ;
    skos:definition "The colour contrast between mottles and soil matrix. See more in Guidelines for Soil Description issued by the FAO: table 34" ;
    skos:member glosis_res:contrastValueCode-D,
        glosis_res:contrastValueCode-F,
        glosis_res:contrastValueCode-P ;
    skos:note "This code list provides the ContrastValue codes."@en ;
    skos:prefLabel "Code list for ContrastValue - codelist class"@en .

glosis_res:CracksDepthValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CracksDepthValueCode ;
    skos:definition "List of suggested classes of surface cracks in shrink–swell clay-rich soils after they dry out. See more in guidelines for Soil Description issued by the FAO: table 21,2" ;
    skos:member glosis_res:cracksDepthValueCode-D,
        glosis_res:cracksDepthValueCode-M,
        glosis_res:cracksDepthValueCode-S,
        glosis_res:cracksDepthValueCode-V ;
    skos:note "This code list provides the CracksDepthValue codes."@en ;
    skos:prefLabel "Code list for CracksDepthValue - codelist class"@en .

glosis_res:CracksDistanceValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CracksDistanceValueCode ;
    skos:definition "Classification of the surface cracks based on distance between the cracks measured in meters. See more in Guidelines for Soil Description issued by the FAO: table 21,3" ;
    skos:member glosis_res:cracksDistanceValueCode-C,
        glosis_res:cracksDistanceValueCode-D,
        glosis_res:cracksDistanceValueCode-M,
        glosis_res:cracksDistanceValueCode-V,
        glosis_res:cracksDistanceValueCode-W ;
    skos:note "This code list provides the CracksDistanceValue codes."@en ;
    skos:prefLabel "Code list for CracksDistanceValue - codelist class"@en .

glosis_res:CracksWidthValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CracksWidthValueCode ;
    skos:definition "Classification of surface cracks based on the width. See more in Guidelines for Soil Description issued by the FAO: table 21,1" ;
    skos:member glosis_res:cracksWidthValueCode-E,
        glosis_res:cracksWidthValueCode-F,
        glosis_res:cracksWidthValueCode-M,
        glosis_res:cracksWidthValueCode-V,
        glosis_res:cracksWidthValueCode-W ;
    skos:note "This code list provides the CracksWidthValue codes."@en ;
    skos:prefLabel "Code list for CracksWidthValue - codelist class"@en .

glosis_res:CropClassValueCollection a skos:Collection ;
    rdfs:seeAlso glosis_res:CropClassValueCode ;
    skos:definition "Examples for the most common crops with their recommended codes. See more in guidelines for Soil Description issued by the FAO: table 9" ;
    skos:member glosis_res:cropClassValueCode-Ce,
