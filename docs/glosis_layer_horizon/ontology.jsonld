    "@id" : "http://w3id.org/glosis/model/layerhorizon/PhysioChemicalValue"
  }, {
    "@id" : "_:genid796"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/ZincTotalElements",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Total zinc includes all forms of zinc in the soil, including soluble, exchangeable, and mineral-bound zinc. It reflects the total zinc reserves but does not indicate immediate bioavailability. Source: Brady, N.C., & Weil, R.R. (2008). The Nature and Properties of Soils."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "ZincTotalElements"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/glosis/model/layerhorizon/PhysioChemical"
  }, {
    "@id" : "_:genid797"
  }, {
    "@id" : "_:genid798"
  }, {
    "@id" : "_:genid799"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/ZincTotalElementsValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
