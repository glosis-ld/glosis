  "@id" : "http://w3id.org/glosis/model/layerhorizon/CalciumExtractableElements",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Extractable calcium is the calcium fraction that can be chemically removed using specific extractants. It represents calcium availability to plants. Source: Sparks, D.L. (2003). Environmental Soil Chemistry."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
