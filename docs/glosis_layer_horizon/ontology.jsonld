  }, {
    "@id" : "_:genid125"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Guidelines for Soil Description issued by the FAO: table 24.1"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/BoundaryTopography",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Boundary topography describes the shape or contour of the boundary between soil horizons. It can be smooth, wavy, irregular, or broken, indicating the processes of soil development and deposition. Source: Soil Survey Manual (USDA, 2017)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "BoundaryTopography"
  } ],
