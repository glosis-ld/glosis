  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Roots presence indicates the occurrence and visibility of roots within soil horizons, reflecting root growth, soil structure, and plant activity. Source: Soil Survey Manual (USDA, 2017)."
  } ],
