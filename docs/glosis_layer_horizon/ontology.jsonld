  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/glosis/model/layerhorizon/PhysioChemicalValue"
  }, {
    "@id" : "_:genid314"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/DryConsistency",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Dry consistency measures the strength and behavior of soil when dry, such as its tendency to crumble or remain intact. It is vital for evaluating soil engineering properties. Source: Soil Survey Manual (USDA, 2017)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DryConsistency"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "_:genid315"
  }, {
    "@id" : "_:genid319"
  }, {
    "@id" : "_:genid320"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/EffectiveCec",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Effective CEC (ECEC) represents the sum of exchangeable bases and exchangeable acidity in soil at its natural pH. It helps evaluate soil fertility under current conditions. Source: Sparks, D.L. (2003). Environmental Soil Chemistry."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EffectiveCec"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/glosis/model/layerhorizon/PhysioChemical"
  }, {
    "@id" : "_:genid321"
  }, {
    "@id" : "_:genid322"
  }, {
    "@id" : "_:genid323"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3"
  } ]
}, {
