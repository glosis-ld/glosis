  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Sample disintegrates into numerous fragments after application of weak pressure."
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCollection"
