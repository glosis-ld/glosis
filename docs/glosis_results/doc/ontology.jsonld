  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/mineralConcKindValueCode-O",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/MineralConcKindValueCollection"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/MineralConcKindValueCode"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The term Other in the context of soil mineral concentrations generally refers to any minerals or materials found in the soil that do not fall under commonly categorized types such as clay, silt, or sand. This could include uncommon minerals, organic matter, or anthropogenic substances that are present in the soil but don't fit into the standard classifications of soil texture or composition. These other substances may have a significant effect on soil properties, influencing aspects like nutrient availability, soil pH, and the ability to retain water. In many cases, Other minerals are identified through advanced soil testing and chemical analysis. Source: Soil Science Society of America."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "O"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Other"
  } ]
}, {
  "@id" : "http://w3id.org/glosis/model/codelists/results/mineralConcKindValueCode-R",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/MineralConcKindValueCollection"
