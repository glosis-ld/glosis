  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Roots abundance measures the density and distribution of roots in a soil horizon. It is classified as few, common, or many based on root counts per unit volume. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."
  } ],
