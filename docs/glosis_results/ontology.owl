        <skos:definition>Although not striking, the mottles are readily seen. The hue, chroma and value of the matrix are easily distinguished from those of the mottles. They may vary by as much as 2.5 units of hue or several units in chroma or value.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/glosis/model/codelists/results/"/>
        <skos:notation>D</skos:notation>
        <skos:prefLabel xml:lang="en">Distinct</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/glosis/model/codelists/results/contrastValueCode-F -->


