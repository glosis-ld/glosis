###  http://w3id.org/glosis/model/codelists/results/ErosionTotalAreaAffectedValueCode
:ErosionTotalAreaAffectedValueCode rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Class ;
                                                         owl:oneOf ( :erosionTotalAreaAffectedValueCode-0
                                                                     :erosionTotalAreaAffectedValueCode-1
