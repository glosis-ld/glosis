        "Sum of the oxalate-extractable aluminium concentration plus half the oxalate-extractable iron concentration" ;
    skos:inScheme glosis_prop: ;
    skos:notation "Alu" ;
    skos:prefLabel "Aluminium (Al) + 0.5 Fe oxalate"@en ;
    ssn:isPropertyOf glosis_lh:GL_Horizon,
        glosis_lh:GL_Layer .

