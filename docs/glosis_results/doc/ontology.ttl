###  http://w3id.org/glosis/model/codelists/results/mineralConcKindValueCode-C
:mineralConcKindValueCode-C rdf:type owl:NamedIndividual ,
                                     :MineralConcKindValueCode ,
                                     <http://www.w3.org/2004/02/skos/core#Concept> ;
                            <http://purl.org/dc/terms/isPartOf> :MineralConcKindValueCollection ;
                            <http://www.w3.org/2004/02/skos/core#definition> "A discrete body with a concentric internal structure, generally cemented." ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/glosis/model/codelists/results/> ;
                            <http://www.w3.org/2004/02/skos/core#notation> "C" ;
