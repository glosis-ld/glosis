}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/TextureLabClass",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Texture lab class categorizes soil texture based on the proportions of sand, silt, and clay determined through laboratory analysis. It is classified into standard texture classes like sandy loam, silty clay, and others. Source: FAO (2006). Guidelines for Soil Description."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "TextureLabClass"
  } ],
