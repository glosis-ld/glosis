    <!-- http://w3id.org/glosis/model/common/SoilDepth -->


    <rdf:Description rdf:about="http://w3id.org/glosis/model/common/SoilDepth">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/hasFeatureOfInterest"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://w3id.org/glosis/model/siteplot/GL_Plot"/>
                            <rdf:Description rdf:about="http://w3id.org/glosis/model/siteplot/GL_Site"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://w3id.org/glosis/model/common/SoilDepthBedrock -->


    <rdf:Description rdf:about="http://w3id.org/glosis/model/common/SoilDepthBedrock">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/hasFeatureOfInterest"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://w3id.org/glosis/model/siteplot/GL_Plot"/>
                            <rdf:Description rdf:about="http://w3id.org/glosis/model/siteplot/GL_Site"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


