    skos:inScheme glosis_res:cracksDistanceValueCode ;
    skos:notation "V" ;
    skos:prefLabel "Very widely spaced > 5"@en ;
    skos:topConceptOf glosis_res:cracksDistanceValueCode .

glosis_res:cracksDistanceValueCode-W a glosis_res:CracksDistanceValueCode,
        skos:Concept ;
    skos:definition "Widely spaced surface crack with distance between 2–5 m" ;
    skos:inScheme glosis_res:cracksDistanceValueCode ;
    skos:notation "W" ;
    skos:prefLabel "Widely spaced 2–5"@en ;
    skos:topConceptOf glosis_res:cracksDistanceValueCode .

glosis_res:cracksWidthValueCode-E a glosis_res:CracksWidthValueCode,
        skos:Concept ;
    skos:definition "Extremely wide surface crack with width more than 10cm" ;
    skos:inScheme glosis_res:cracksWidthValueCode ;
    skos:notation "E" ;
    skos:prefLabel "Extremely wide > 10cm"@en ;
    skos:topConceptOf glosis_res:cracksWidthValueCode .

glosis_res:cracksWidthValueCode-F a glosis_res:CracksWidthValueCode,
        skos:Concept ;
    skos:definition "Fine surface crack with width less than 1 cm" ;
    skos:inScheme glosis_res:cracksWidthValueCode ;
    skos:notation "F" ;
    skos:prefLabel "Fine < 1cm"@en ;
    skos:topConceptOf glosis_res:cracksWidthValueCode .

glosis_res:cracksWidthValueCode-M a glosis_res:CracksWidthValueCode,
        skos:Concept ;
    skos:definition "Medium surface crack with width 1 - 2 cm" ;
    skos:inScheme glosis_res:cracksWidthValueCode ;
    skos:notation "M" ;
    skos:prefLabel "Medium 1cm–2cm"@en ;
    skos:topConceptOf glosis_res:cracksWidthValueCode .

glosis_res:cracksWidthValueCode-V a glosis_res:CracksWidthValueCode,
        skos:Concept ;
