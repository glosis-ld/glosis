    <!-- http://w3id.org/glosis/model/codelists/properties/ClayPropertyCode -->


    <owl:Class rdf:about="http://w3id.org/glosis/model/codelists/properties/ClayPropertyCode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/properties/clayPropertyCode-CC"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/properties/clayPropertyCode-CNC"/>
                    <rdf:Description rdf:about="http://w3id.org/glosis/model/codelists/properties/clayPropertyCode-CWT"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">This code list class provides the ClayProperty codes.</rdfs:comment>
        <rdfs:label xml:lang="en">Code list class for ClayProperty - codelist class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/glosis/model/codelists/properties/ClayPropertyCollection"/>
        <skos:definition>ISRIC Report 2019/01: Tier 1 and Tier 2 data in the context of the federated Global Soil Information System. Appendix 3</skos:definition>
    </owl:Class>
    


