  "@id" : "http://w3id.org/glosis/model/codelists/results/bulkDensityMineralValueCode-BD1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "http://w3id.org/glosis/model/codelists/results/BulkDensityMineralValueCollection"
