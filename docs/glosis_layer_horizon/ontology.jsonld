}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/CarbonOrganic",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Organic carbon refers to carbon stored in soil organic matter, including plant residues, microorganisms, and humus. It is a key indicator of soil health and fertility. Source: Brady, N.C., & Weil, R.R. (2017). The Nature and Properties of Soils."
  } ],
