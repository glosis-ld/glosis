}, {
  "@id" : "http://w3id.org/glosis/model/layerhorizon/Plasticity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Plasticity describes the ability of soil to deform without cracking or breaking under applied pressure. It is a property of clay-rich soils. Source: Soil Mechanics (Terzaghi et al., 1996)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
