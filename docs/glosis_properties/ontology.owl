    <!-- http://w3id.org/glosis/model/codelists/properties/physioChemicalPropertyCode-ManKCl -->


    <owl:NamedIndividual rdf:about="http://w3id.org/glosis/model/codelists/properties/physioChemicalPropertyCode-ManKCl">
        <rdf:type rdf:resource="http://dbpedia.org/ontology/ChemicalCompound"/>
        <rdf:type rdf:resource="http://dbpedia.org/ontology/ChemicalSubstance"/>
